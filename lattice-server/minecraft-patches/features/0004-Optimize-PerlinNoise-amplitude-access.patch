 import net.minecraft.util.Mth;
 import net.minecraft.util.RandomSource;
 
-public final class ImprovedNoise {
+public final class ImprovedNoise implements com.latticemc.lattice.bridge.ImprovedNoiseAccessor {
     private static final float SHIFT_UP_EPSILON = 1.0E-7F;
     private static final double[] FLAT_SIMPLEX_GRADIENT = new double[]{
         1.0, 1.0, 0.0, 0.0,
