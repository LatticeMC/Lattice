@@ -63,6 +63,21 @@ public class SurfaceSystem {
         this.icebergSurfaceNoise = randomState.getOrCreateNoise(Noises.ICEBERG_SURFACE);
     }
 
+    @Override
+    public int lattice$seaLevel() {
+        return this.seaLevel;
+    }
