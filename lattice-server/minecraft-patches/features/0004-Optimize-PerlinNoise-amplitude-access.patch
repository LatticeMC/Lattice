+    @Override
+    public NormalNoise lattice$surfaceNoise() {
+        return this.surfaceNoise;
+    }
+
+    @Override
+    public NormalNoise lattice$surfaceSecondaryNoise() {
+        return this.surfaceSecondaryNoise;
+    }
+
     public void buildSurface(
         RandomState randomState,
         BiomeManager biomeManager,
diff --git a/net/minecraft/world/level/levelgen/synth/ImprovedNoise.java b/net/minecraft/world/level/levelgen/synth/ImprovedNoise.java
index 4f4bb37f70d7a9334b4dd33e865a36290a198ffb..8d1ec147f230d9bed0a4c740be7cd41ab8c4951f 100644
