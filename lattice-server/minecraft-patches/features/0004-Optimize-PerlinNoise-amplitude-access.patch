@@ -18,7 +18,7 @@ import net.minecraft.util.RandomSource;
 import net.minecraft.world.level.levelgen.PositionalRandomFactory;
 import org.jspecify.annotations.Nullable;
 
-public class PerlinNoise {
+public class PerlinNoise implements com.latticemc.lattice.bridge.PerlinNoiseAccessor {
     private static final int ROUND_OFF = 33554432;
     private final @Nullable ImprovedNoise[] noiseLevels;
     private final int firstOctave;
@@ -26,6 +26,7 @@ public class PerlinNoise {
     private final double lowestFreqValueFactor;
     private final double lowestFreqInputFactor;
     private final double maxValue;
+    private final double[] amplitudesArray;
 
     @Deprecated
     public static PerlinNoise createLegacyForBlendedNoise(RandomSource random, IntStream octaves) {
@@ -81,6 +82,7 @@ public class PerlinNoise {
     protected PerlinNoise(RandomSource random, Pair<Integer, DoubleList> octavesAndAmplitudes, boolean useNewFactory) {
         this.firstOctave = octavesAndAmplitudes.getFirst();
         this.amplitudes = octavesAndAmplitudes.getSecond();
+        this.amplitudesArray = this.amplitudes.toDoubleArray();
         int size = this.amplitudes.size();
         int i = -this.firstOctave;
         this.noiseLevels = new ImprovedNoise[size];
@@ -133,12 +135,52 @@ public class PerlinNoise {
         return this.maxValue;
     }
 
+    @Override
+    public ImprovedNoise[] lattice$getNoiseLevels() {
+        return this.noiseLevels;
+    }
+
+    @Override
+    public DoubleList lattice$getAmplitudes() {
+        return this.amplitudes;
+    }
+
+    @Override
+    public double[] lattice$getAmplitudesArray() {
+        return this.amplitudesArray;
+    }
+
+    @Override
+    public double lattice$getLowestFreqInputFactor() {
+        return this.lowestFreqInputFactor;
+    }
+
+    @Override
+    public double lattice$getLowestFreqValueFactor() {
+        return this.lowestFreqValueFactor;
+    }
+
     private static void skipOctave(RandomSource random) {
         random.consumeCount(262);
     }
 
     public double getValue(double x, double y, double z) {
-        return this.getValue(x, y, z, 0.0, 0.0, false);
+        double d = 0.0;
+        double d1 = this.lowestFreqInputFactor;
+        double d2 = this.lowestFreqValueFactor;
+
+        for (int i = 0; i < this.noiseLevels.length; i++) {
+            ImprovedNoise improvedNoise = this.noiseLevels[i];
+            if (improvedNoise != null) {
+                double d3 = improvedNoise.noise(wrap(x * d1), wrap(y * d1), wrap(z * d1), 0.0, 0.0);
+                d += this.amplitudesArray[i] * d3 * d2;
+            }
+
+            d1 *= 2.0;
+            d2 /= 2.0;
+        }
+
+        return d;
     }
 
     @Deprecated
@@ -151,7 +193,7 @@ public class PerlinNoise {
             ImprovedNoise improvedNoise = this.noiseLevels[i];
             if (improvedNoise != null) {
                 double d3 = improvedNoise.noise(wrap(x * d1), useFixedY ? -improvedNoise.yo : wrap(y * d1), wrap(z * d1), yScale * d1, yMax * d1);
-                d += this.amplitudes.getDouble(i) * d3 * d2;
+                d += this.amplitudesArray[i] * d3 * d2;
             }
 
             d1 *= 2.0;
@@ -172,7 +214,7 @@ public class PerlinNoise {
         for (int i = 0; i < this.noiseLevels.length; i++) {
             ImprovedNoise improvedNoise = this.noiseLevels[i];
             if (improvedNoise != null) {
-                d += this.amplitudes.getDouble(i) * multiplier * d1;
+                d += this.amplitudesArray[i] * multiplier * d1;
             }
 
             d1 /= 2.0;
