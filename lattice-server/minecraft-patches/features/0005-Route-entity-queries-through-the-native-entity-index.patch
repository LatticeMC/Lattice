Subject: [PATCH] Route entity queries through the native entity index


diff --git a/net/minecraft/server/level/ServerEntityGetter.java b/net/minecraft/server/level/ServerEntityGetter.java
index 878000d1b5ec5d7944fc4da9ff9936fe78d044fc..89788b19dcce9f72d7856ef3ca238ef6622b831d 100644
--- a/net/minecraft/server/level/ServerEntityGetter.java
+++ b/net/minecraft/server/level/ServerEntityGetter.java
@@ -54,6 +54,27 @@ public interface ServerEntityGetter extends EntityGetter {
     default <T extends LivingEntity> @Nullable T getNearestEntity(
         List<? extends T> entities, TargetingConditions targetingConditions, @Nullable LivingEntity source, double x, double y, double z
     ) {
+        if (entities.size() >= 8) {
+            double range = 0.0D;
+            for (T entity : entities) {
+                double dx = Math.abs(entity.getX() - x);
+                double dy = Math.abs(entity.getY() - y);
+                double dz = Math.abs(entity.getZ() - z);
+                range = Math.max(range, Math.max(dx, Math.max(dy, dz)) + 2.0D);
+            }
+            AABB area = AABB.ofSize(new net.minecraft.world.phys.Vec3(x, y, z), range * 2.0D, range * 2.0D, range * 2.0D);
+            return com.latticemc.lattice.bridge.NativeGoalQuerySupport.findNearestEntityNullableSource(
+                source,
+                this.getLevel(),
+                entities,
+                targetingConditions,
+                area,
+                x,
+                y,
+                z
+            );
+        }
+
         double d = -1.0;
         T livingEntity = null;
 
