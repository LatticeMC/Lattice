From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sweepikun <laomgba@outlook.com>
Date: Sat, 25 Jul 2026 14:19:45 +0800
Subject: [PATCH] Accelerate light propagation and spawn checks with native
 code


diff --git a/net/minecraft/world/level/lighting/DynamicGraphMinFixedPoint.java b/net/minecraft/world/level/lighting/DynamicGraphMinFixedPoint.java
index f7de641d30577be3c4c6a44efdffaed7662d8aae..57069f9a3ee7125f451fc73978ef2491601f4d60 100644
--- a/net/minecraft/world/level/lighting/DynamicGraphMinFixedPoint.java
+++ b/net/minecraft/world/level/lighting/DynamicGraphMinFixedPoint.java
@@ -1,5 +1,9 @@
 package net.minecraft.world.level.lighting;
 
+import com.latticemc.lattice.bridge.LightEngineCallbacks;
+import com.latticemc.lattice.bridge.NativeLightEngineBridge;
+import com.latticemc.lattice.nativelib.LatticeNative;
+import com.latticemc.lattice.nativelib.NativeLightEngine;
 import it.unimi.dsi.fastutil.longs.Long2ByteMap;
 import it.unimi.dsi.fastutil.longs.Long2ByteOpenHashMap;
 import it.unimi.dsi.fastutil.longs.LongArrayList;
@@ -7,13 +11,15 @@ import it.unimi.dsi.fastutil.longs.LongList;
 import java.util.function.LongPredicate;
 import net.minecraft.util.Mth;
 
-public abstract class DynamicGraphMinFixedPoint {
+public abstract class DynamicGraphMinFixedPoint implements LightEngineCallbacks {
     public static final long SOURCE = Long.MAX_VALUE;
     private static final int NO_COMPUTED_LEVEL = 255;
     protected final int levelCount;
     private final LeveledPriorityQueue priorityQueue;
     private final Long2ByteMap computedLevels;
     private volatile boolean hasWork;
+    private NativeLightEngine nativeEngine;
+    private boolean nativeEngineDisabled;
 
     protected DynamicGraphMinFixedPoint(int firstQueuedLevel, int width, final int height) {
         if (firstQueuedLevel >= 254) {
@@ -31,6 +37,15 @@ public abstract class DynamicGraphMinFixedPoint {
             };
             this.computedLevels.defaultReturnValue((byte)-1);
         }
+
+        if (LatticeNative.isLoaded()) {
+            try {
+                this.nativeEngine = new NativeLightEngineBridge(this, firstQueuedLevel, width, height);
+            } catch (Exception e) {
+                LatticeNative.logFallbackOnce("light_engine", "failed to create native engine: " + e.getMessage());
+                this.nativeEngineDisabled = true;
+            }
+        }
     }
 
     protected void removeFromQueue(long position) {
@@ -123,6 +138,21 @@ public abstract class DynamicGraphMinFixedPoint {
     }
 
     protected final int runUpdates(int toUpdateCount) {
+        if (LatticeNative.isLoaded() && !this.nativeEngineDisabled && this.nativeEngine != null) {
+            if (!this.nativeEngine.isNativeActive()) {
+                this.nativeEngineDisabled = true;
+            } else {
+                try {
+                    return this.nativeEngine.applyPendingUpdates(toUpdateCount);
+                } catch (IllegalStateException e) {
+                    LatticeNative.logFallbackOnce("light_engine",
+                            "native BFS failed, falling back to JVM: " + e.getMessage());
+                    this.nativeEngine.disable();
+                    this.nativeEngineDisabled = true;
+                    // fall through to vanilla
+                }
+            }
+        }
         if (this.priorityQueue.isEmpty()) {
             return toUpdateCount;
         } else {
@@ -167,4 +197,37 @@ public abstract class DynamicGraphMinFixedPoint {
     protected abstract void setLevel(long chunkPos, int level);
 
     protected abstract int computeLevelFromNeighbor(long startPos, long endPos, int startLevel);
+
+    // ---- LightEngineCallbacks implementation ----
+
+    @Override
+    public int callbackGetPropagatedLevel(long source, long target, int level) {
+        return this.computeLevelFromNeighbor(source, target, level);
+    }
+
+    @Override
+    public void callbackPropagateLevel(long nativePtr, long source, long target,
+                                       int level, boolean decrease) {
+        this.checkNeighborsAfterUpdate(target, level, decrease);
+    }
+
+    @Override
+    public boolean callbackIsMarker(long id) {
+        return this.isSource(id);
+    }
+
+    @Override
+    public int callbackRecalculateLevel(long id, long excludedId, int maxLevel) {
+        return this.getComputedLevel(id, excludedId, maxLevel);
+    }
+
+    @Override
+    public int callbackGetCommittedLevel(long id) {
+        return this.getLevel(id);
+    }
+
+    @Override
+    public void callbackSetCommittedLevel(long id, int level) {
+        this.setLevel(id, level);
+    }
 }
