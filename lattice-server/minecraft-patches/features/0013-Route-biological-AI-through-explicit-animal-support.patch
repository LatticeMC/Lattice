From: sweepikun <laomgba@outlook.com>
Date: Sat, 25 Jul 2026 14:43:12 +0800
Subject: [PATCH] Route biological AI through explicit animal support


diff --git a/net/minecraft/world/entity/animal/Animal.java b/net/minecraft/world/entity/animal/Animal.java
index 53d04c412d36015a30ae2680f61651db6acbf2f2..fec098e4f8a6eaaa9a2c6d9af4eac7b9b311e316 100644
--- a/net/minecraft/world/entity/animal/Animal.java
+++ b/net/minecraft/world/entity/animal/Animal.java
@@ -1,5 +1,6 @@
 package net.minecraft.world.entity.animal;
 
+import com.latticemc.lattice.bridge.AnimalBiologicalAiSupport;
 import java.util.Optional;
 import net.minecraft.advancements.CriteriaTriggers;
 import net.minecraft.core.BlockPos;
@@ -46,6 +47,9 @@ public abstract class Animal extends AgeableMob {
     public int inLove = 0;
     public @Nullable EntityReference<ServerPlayer> loveCause;
     public @Nullable ItemStack breedItem; // CraftBukkit - Add breedItem variable
+    private @Nullable LivingEntity nativeAiCachedChickenThreat;
+    private @Nullable LivingEntity nativeAiCachedPrey;
+    private boolean nativeAiCachedBabyAlert;
     public abstract int getPurpurBreedTime(); // Purpur - Make entity breeding times configurable
 
     protected Animal(EntityType<? extends Animal> type, Level level) {
@@ -65,6 +69,31 @@ public abstract class Animal extends AgeableMob {
         }
 
         super.customServerAiStep(level);
+        AnimalBiologicalAiSupport.run(this, level); // Lattice - native biological AI
+    }
+
+    public @Nullable LivingEntity nativeAiCachedChickenThreat() {
+        return this.nativeAiCachedChickenThreat;
+    }
+
+    public void nativeAiCachedChickenThreat(@Nullable LivingEntity threat) {
+        this.nativeAiCachedChickenThreat = threat;
+    }
+
+    public @Nullable LivingEntity nativeAiCachedPrey() {
+        return this.nativeAiCachedPrey;
+    }
+
+    public void nativeAiCachedPrey(@Nullable LivingEntity prey) {
+        this.nativeAiCachedPrey = prey;
+    }
+
+    public boolean nativeAiCachedBabyAlert() {
+        return this.nativeAiCachedBabyAlert;
+    }
+
+    public void nativeAiCachedBabyAlert(boolean babyAlert) {
+        this.nativeAiCachedBabyAlert = babyAlert;
     }
 
     @Override
