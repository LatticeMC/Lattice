Subject: [PATCH] Accelerate heightmap priming and noise sampling with native
 code


diff --git a/net/minecraft/world/level/levelgen/Heightmap.java b/net/minecraft/world/level/levelgen/Heightmap.java
index a4f6e74ff105c19a50ac025f8b5f0cde8b6ef937..2cfb0c6589d07c0e80d114e96d669cb25924e840 100644
--- a/net/minecraft/world/level/levelgen/Heightmap.java
+++ b/net/minecraft/world/level/levelgen/Heightmap.java
@@ -1,5 +1,9 @@
 package net.minecraft.world.level.levelgen;
 
+import com.latticemc.lattice.bridge.WorldgenNativeSupport;
+import com.latticemc.lattice.nativelib.LatticeNative;
+import com.latticemc.lattice.nativelib.NativeWorldgenToggle;
+import com.latticemc.lattice.nativelib.WorldgenProfiler;
 import com.mojang.logging.LogUtils;
 import com.mojang.serialization.Codec;
 import io.netty.buffer.ByteBuf;
@@ -41,6 +45,18 @@ public class Heightmap implements com.latticemc.lattice.bridge.HeightmapAccessor
     }
 
     public static void primeHeightmaps(ChunkAccess chunk, Set<Heightmap.Types> types) {
+        long nativeStart = WorldgenProfiler.start();
+        try {
+            if (NativeWorldgenToggle.heightmapEnabled() && !types.isEmpty() && LatticeNative.isLoaded()) {
+                WorldgenNativeSupport.primeHeightmaps(chunk, types);
+                return;
+            }
+        } catch (Exception | LinkageError exception) {
+            LatticeNative.logFallbackOnce("native_heightmap", exception.getMessage());
+        } finally {
+            WorldgenProfiler.end("heightmap.primeHeightmaps", nativeStart);
+        }
+
         if (!types.isEmpty()) {
             int size = types.size();
             ObjectList<Heightmap> list = new ObjectArrayList<>(size);
