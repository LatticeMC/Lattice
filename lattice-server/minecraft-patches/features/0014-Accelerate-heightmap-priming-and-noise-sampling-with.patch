         instance -> instance.group(
@@ -36,6 +39,7 @@ public class BlendedNoise implements DensityFunction.SimpleFunction {
     private final double maxValue;
     private final double xzScale;
     private final double yScale;
+    private final NativeInterpolatedNoise nativeInterpolatedNoise;
 
     public static BlendedNoise createUnseeded(double xzScale, double yScale, double xzFactor, double yFactor, double smearScaleMultiplier) {
         return new BlendedNoise(new XoroshiroRandomSource(0L), xzScale, yScale, xzFactor, yFactor, smearScaleMultiplier);
@@ -62,6 +66,21 @@ public class BlendedNoise implements DensityFunction.SimpleFunction {
         this.xzMultiplier = 684.412 * this.xzScale;
         this.yMultiplier = 684.412 * this.yScale;
         this.maxValue = minLimitNoise.maxBrokenValue(this.yMultiplier);
+        this.nativeInterpolatedNoise = WorldgenNativeSupport.createInterpolated(
+            this.minLimitNoise,
+            this.maxLimitNoise,
+            this.mainNoise,
+            this.xzScale,
+            this.yScale,
+            this.xzFactor,
+            this.yFactor,
+            this.smearScaleMultiplier
+        );
+    }
+
+    @Override
+    public NativeInterpolatedNoise lattice$getNativeInterpolatedNoise() {
+        return this.nativeInterpolatedNoise;
     }
 
     @VisibleForTesting
