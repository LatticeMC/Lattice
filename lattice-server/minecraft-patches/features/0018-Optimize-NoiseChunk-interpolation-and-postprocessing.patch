+        private static void lattice$fillCellArrayWidth4(
+            double[] array,
+            int cellHeight,
+            double noise000,
+            double noise100,
+            double noise010,
+            double noise110,
+            double noise001,
+            double noise101,
+            double noise011,
+            double noise111
+        ) {
+            int arrayIndex = 0;
+            for (int y = cellHeight - 1; y >= 0; y--) {
+                double yFraction = (double)y / cellHeight;
+                for (int x = 0; x < 4; x++) {
+                    double xFraction = x * 0.25;
+                    double valueZ0 = Mth.lerp(
+                        yFraction, Mth.lerp(xFraction, noise000, noise100), Mth.lerp(xFraction, noise010, noise110)
+                    );
+                    double valueZ1 = Mth.lerp(
+                        yFraction, Mth.lerp(xFraction, noise001, noise101), Mth.lerp(xFraction, noise011, noise111)
+                    );
+                    array[arrayIndex++] = Mth.lerp(0.0, valueZ0, valueZ1);
+                    array[arrayIndex++] = Mth.lerp(0.25, valueZ0, valueZ1);
+                    array[arrayIndex++] = Mth.lerp(0.5, valueZ0, valueZ1);
+                    array[arrayIndex++] = Mth.lerp(0.75, valueZ0, valueZ1);
+                }
+            }
+        }
+
         @Override
