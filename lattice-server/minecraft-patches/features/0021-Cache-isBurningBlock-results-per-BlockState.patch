From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sweepikun <laomgba@outlook.com>
Date: Tue, 28 Jul 2026 13:27:29 +0800
Subject: [PATCH] Cache isBurningBlock results per BlockState


diff --git a/net/minecraft/world/level/pathfinder/NodeEvaluator.java b/net/minecraft/world/level/pathfinder/NodeEvaluator.java
index 73aacb7b64b5518937273b4a70df944ad05a1b2b..cc37ec8f9841420c49f356e97911dbf6a94d94d1 100644
--- a/net/minecraft/world/level/pathfinder/NodeEvaluator.java
+++ b/net/minecraft/world/level/pathfinder/NodeEvaluator.java
@@ -95,7 +95,41 @@ public abstract class NodeEvaluator {
         return this.canWalkOverFences;
     }
 
+    // Lattice start - cache isBurningBlock per BlockState
+    // The five checks below are pure functions of the BlockState, and tags do
+    // not change at runtime, yet JFR attributed ~17% of Server-thread self time
+    // during pathfinding to the ReferenceOpenHashSet.contains calls behind
+    // state.is(tag) reached from here. BlockStates are interned singletons, so
+    // a direct-mapped table keyed on identity hash collapses that to one
+    // reference compare on hit.
+    //
+    // Each distinct property combination (including a campfire's LIT) is its own
+    // interned BlockState, so one boolean per state is always well defined.
+    //
+    // A single Boolean holder per slot keeps the state and its result in one
+    // reference, so a reader can never pair a state with a result computed for a
+    // different state -- publishing them as two separate array stores would need
+    // ordering guarantees that plain array writes do not provide. A racing writer
+    // at worst makes another thread recompute this pure function.
+    private static final int BURNING_CACHE_MASK = 1023;
+    private static final Entry[] BURNING_CACHE = new Entry[BURNING_CACHE_MASK + 1];
+
+    private record Entry(BlockState state, boolean burning) {}
+
     public static boolean isBurningBlock(BlockState state) {
+        int slot = System.identityHashCode(state) & BURNING_CACHE_MASK;
+        Entry cached = BURNING_CACHE[slot];
+        if (cached != null && cached.state() == state) {
+            return cached.burning();
+        }
+
+        boolean burning = computeIsBurningBlock(state);
+        BURNING_CACHE[slot] = new Entry(state, burning);
+        return burning;
+    }
+
+    private static boolean computeIsBurningBlock(BlockState state) {
+        // Lattice end - cache isBurningBlock per BlockState
         return state.is(BlockTags.FIRE)
             || state.is(Blocks.LAVA)
             || state.is(Blocks.MAGMA_BLOCK)
