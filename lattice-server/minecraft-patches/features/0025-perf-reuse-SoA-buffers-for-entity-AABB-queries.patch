@@ -11,6 +11,11 @@ import org.slf4j.Logger;
 
 public class EntitySection<T extends EntityAccess> {
     private static final Logger LOGGER = LogUtils.getLogger();
+    // The JNI transition does not amortise below this point.  Large sections are
+    // the collision hot path and retain their original iteration order here.
+    private static final int NATIVE_AABB_MIN_ENTITIES = 32;
+    private static final ThreadLocal<NativeAabbScratchStack> NATIVE_AABB_SCRATCH =
+        ThreadLocal.withInitial(NativeAabbScratchStack::new);
     private final ClassInstanceMultiMap<T> storage;
     private Visibility chunkStatus;
 
@@ -35,10 +40,18 @@ public class EntitySection<T extends EntityAccess> {
 
     public AbortableIterationConsumer.Continuation getEntities(AABB bounds, AbortableIterationConsumer<T> consumer) {
         if (com.latticemc.lattice.nativelib.NativeAabbQuery.isAvailable()) {
-            java.util.ArrayList<T> entities = new java.util.ArrayList<>(this.storage);
-            AbortableIterationConsumer.Continuation result = scanEntitiesNative(entities, bounds, consumer);
-            if (result != null) {
-                return result;
+            int entityCount = this.storage.size();
+            if (entityCount >= NATIVE_AABB_MIN_ENTITIES) {
+                NativeAabbScratch scratch = NATIVE_AABB_SCRATCH.get().acquire(entityCount);
+                try {
+                    int index = 0;
+                    for (T entityAccess : this.storage) {
+                        scratch.set(index++, entityAccess);
+                    }
+                    return scanEntitiesNative(scratch, entityCount, bounds, consumer);
+                } finally {
+                    NATIVE_AABB_SCRATCH.get().release();
+                }
             }
         }
 
@@ -59,17 +72,21 @@ public class EntitySection<T extends EntityAccess> {
             return AbortableIterationConsumer.Continuation.CONTINUE;
         } else {
             if (com.latticemc.lattice.nativelib.NativeAabbQuery.isAvailable()) {
-                java.util.ArrayList<U> entities = new java.util.ArrayList<>(collection.size());
-                for (T entityAccess : collection) {
-                    U cast = (U)test.tryCast(entityAccess);
-                    if (cast != null) {
-                        entities.add(cast);
+                NativeAabbScratchStack scratchStack = NATIVE_AABB_SCRATCH.get();
