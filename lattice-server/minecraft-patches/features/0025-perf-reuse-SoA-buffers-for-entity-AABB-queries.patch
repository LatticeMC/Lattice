+        scratch.query[4] = bounds.maxY;
+        scratch.query[5] = bounds.maxZ;
         for (int i = 0; i < entityCount; ++i) {
-            AABB box = entities.get(i).getBoundingBox();
-            int base = i * com.latticemc.lattice.nativelib.NativeAabbQuery.AABB_STRIDE;
-            entityAabbs[base] = box.minX;
-            entityAabbs[base + 1] = box.minY;
-            entityAabbs[base + 2] = box.minZ;
-            entityAabbs[base + 3] = box.maxX;
-            entityAabbs[base + 4] = box.maxY;
-            entityAabbs[base + 5] = box.maxZ;
+            AABB box = ((EntityAccess)scratch.entities[i]).getBoundingBox();
+            scratch.aabbs[i] = box.minX;
+            scratch.aabbs[entityCount + i] = box.minY;
+            scratch.aabbs[entityCount * 2 + i] = box.minZ;
+            scratch.aabbs[entityCount * 3 + i] = box.maxX;
