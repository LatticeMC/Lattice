+    private static final class NativeAabbScratchStack {
+        private final java.util.ArrayList<NativeAabbScratch> entries = new java.util.ArrayList<>();
+        private int depth;
+
+        NativeAabbScratch acquire(int entityCount) {
+            if (this.depth == this.entries.size()) {
+                this.entries.add(new NativeAabbScratch());
+            }
+            NativeAabbScratch scratch = this.entries.get(this.depth++);
+            scratch.ensureCapacity(entityCount);
+            return scratch;
+        }
+
+        void release() {
+            --this.depth;
+        }
+    }
+
+    private static final class NativeAabbScratch {
+        private Object[] entities = new Object[0];
+        private double[] aabbs = new double[0];
+        private final double[] query = new double[6];
+        private long[] visibility = new long[0];
+
+        void ensureCapacity(int entityCount) {
+            if (this.entities.length < entityCount) {
+                this.entities = new Object[entityCount];
+                this.aabbs = new double[entityCount * com.latticemc.lattice.nativelib.NativeAabbQuery.AABB_STRIDE];
+            }
+            int visibilityLongs = com.latticemc.lattice.nativelib.NativeAabbQuery.rowLongs(entityCount);
+            if (this.visibility.length < visibilityLongs) {
+                this.visibility = new long[visibilityLongs];
+            }
+        }
+
+        void set(int index, Object entity) {
+            this.entities[index] = entity;
+        }
+    }
+
     public boolean isEmpty() {
         return this.storage.isEmpty();
     }
