+                    }
+                } finally {
+                    scratchStack.release();
                 }
             }
 
@@ -84,39 +101,37 @@ public class EntitySection<T extends EntityAccess> {
         }
     }
 
-    private static <E extends EntityAccess> AbortableIterationConsumer.Continuation scanEntitiesNative(
-        java.util.ArrayList<E> entities,
+    @SuppressWarnings({"rawtypes", "unchecked"})
+    private static AbortableIterationConsumer.Continuation scanEntitiesNative(
+        NativeAabbScratch scratch,
+        int entityCount,
         AABB bounds,
-        AbortableIterationConsumer<? super E> consumer
+        AbortableIterationConsumer consumer
     ) {
-        int entityCount = entities.size();
-        if (entityCount < 8) {
-            return null;
-        }
-
-        double[] query = {
-            bounds.minX, bounds.minY, bounds.minZ,
-            bounds.maxX, bounds.maxY, bounds.maxZ
-        };
-        double[] entityAabbs = new double[entityCount * com.latticemc.lattice.nativelib.NativeAabbQuery.AABB_STRIDE];
+        scratch.query[0] = bounds.minX;
+        scratch.query[1] = bounds.minY;
+        scratch.query[2] = bounds.minZ;
