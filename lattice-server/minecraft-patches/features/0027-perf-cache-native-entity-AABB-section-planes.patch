+    /** Receives Entity#setBoundingBox after the entity's section callback ran. */
+    public void updateEntityBoundingBox(final Entity entity, final AABB box) {
+        final int sectionX = ((ChunkSystemEntity)entity).moonrise$getSectionX();
+        final int sectionY = ((ChunkSystemEntity)entity).moonrise$getSectionY();
+        final int sectionZ = ((ChunkSystemEntity)entity).moonrise$getSectionZ();
+        if (sectionX == Integer.MIN_VALUE || sectionY == Integer.MIN_VALUE || sectionZ == Integer.MIN_VALUE) {
+            return;
+        }
+        final ChunkEntitySlices slices = this.getChunk(sectionX, sectionZ);
+        if (slices != null && slices.hasNativeAabbCache()) {
+            slices.updateEntityBoundingBox(entity, sectionY, box);
+        }
+    }
