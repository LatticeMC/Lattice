+    /**
+     * Exact broad-phase for a dense BasicEntityList. The important difference
+     * from the previous JNI path is that it avoids making one native call per
+     * entity query: nearby push/collision queries only visit the occupied
+     * one-block cells touching the query box.
+     */
+    private static final class SpatialAabbIndex<E extends Entity> {
+
+        private static final long OVERFLOW_CELL = Long.MIN_VALUE;
+
+        private final Long2ObjectOpenHashMap<SpatialBucket<E>> cells = new Long2ObjectOpenHashMap<>();
+        private final Reference2LongOpenHashMap<E> cellByEntity = new Reference2LongOpenHashMap<>();
+        private final ArrayList<E> overflow = new ArrayList<>();
+
+        SpatialAabbIndex(final int expectedSize) {
+            this.cellByEntity.defaultReturnValue(OVERFLOW_CELL);
+            this.cells.ensureCapacity(expectedSize);
+        }
+
+        void add(final E entity, final AABB box) {
+            final long cell = this.cellFor(box);
+            this.cellByEntity.put(entity, cell);
+            if (cell == OVERFLOW_CELL) {
+                this.overflow.add(entity);
+                return;
+            }
+            SpatialBucket<E> bucket = this.cells.get(cell);
+            if (bucket == null) {
+                this.cells.put(cell, bucket = new SpatialBucket<>());
+            }
+            bucket.add(entity);
+        }
+
+        void remove(final E entity) {
+            final long cell = this.cellByEntity.removeLong(entity);
+            if (cell == OVERFLOW_CELL) {
+                for (int index = 0, len = this.overflow.size(); index < len; ++index) {
+                    if (this.overflow.get(index) == entity) {
+                        this.overflow.remove(index);
+                        return;
+                    }
+                }
+                return;
+            }
+            final SpatialBucket<E> bucket = this.cells.get(cell);
+            if (bucket != null && bucket.remove(entity) && bucket.isEmpty()) {
+                this.cells.remove(cell);
+            }
+        }
+
+        void update(final E entity, final AABB box) {
+            final long oldCell = this.cellByEntity.getLong(entity);
+            final long newCell = this.cellFor(box);
+            if (oldCell == newCell) {
+                return;
+            }
+            this.remove(entity);
+            this.add(entity, box);
+        }
+
+        int scan(final Entity except, final AABB box, final List<Entity> into,
+                 final Predicate<? super Entity> predicate, final int maxCount) {
+            final int minX = Mth.floor(box.minX - SPATIAL_MAX_SMALL_HALF_SPAN);
+            final int minY = Mth.floor(box.minY - SPATIAL_MAX_SMALL_HALF_SPAN);
+            final int minZ = Mth.floor(box.minZ - SPATIAL_MAX_SMALL_HALF_SPAN);
+            final int maxX = Mth.floor(box.maxX + SPATIAL_MAX_SMALL_HALF_SPAN);
+            final int maxY = Mth.floor(box.maxY + SPATIAL_MAX_SMALL_HALF_SPAN);
+            final int maxZ = Mth.floor(box.maxZ + SPATIAL_MAX_SMALL_HALF_SPAN);
+            final long cellsToVisit = (long)(maxX - minX + 1) * (long)(maxY - minY + 1) * (long)(maxZ - minZ + 1);
+            if (cellsToVisit > SPATIAL_MAX_QUERY_CELLS) {
+                return -1;
+            }
+
+            for (int cellY = minY; cellY <= maxY; ++cellY) {
+                for (int cellZ = minZ; cellZ <= maxZ; ++cellZ) {
+                    for (int cellX = minX; cellX <= maxX; ++cellX) {
+                        final SpatialBucket<E> bucket = this.cells.get(BlockPos.asLong(cellX, cellY, cellZ));
+                        if (bucket == null) {
+                            continue;
+                        }
+                        if (this.scanBucket(bucket, except, box, into, predicate, maxCount)) {
+                            return 1;
+                        }
+                    }
+                }
+            }
+            for (int index = 0, len = this.overflow.size(); index < len; ++index) {
+                final E entity = this.overflow.get(index);
+                if (this.matches(entity, except, box, predicate)) {
+                    into.add(entity);
+                    if (into.size() >= maxCount) {
+                        return 1;
+                    }
+                }
+            }
+            return 0;
+        }
+
+        private boolean scanBucket(final SpatialBucket<E> bucket, final Entity except, final AABB box,
+                                   final List<Entity> into, final Predicate<? super Entity> predicate, final int maxCount) {
+            for (int index = 0, len = bucket.size; index < len; ++index) {
+                final E entity = bucket.get(index);
+                if (this.matches(entity, except, box, predicate)) {
+                    into.add(entity);
+                    if (into.size() >= maxCount) {
+                        return true;
+                    }
+                }
+            }
+            return false;
+        }
+
+        private boolean matches(final E entity, final Entity except, final AABB box, final Predicate<? super Entity> predicate) {
+            return entity != except && entity.getBoundingBox().intersects(box)
+                && (predicate == null || predicate.test(entity));
+        }
+
+        private long cellFor(final AABB box) {
+            if (box.getXsize() > SPATIAL_MAX_SMALL_SPAN || box.getYsize() > SPATIAL_MAX_SMALL_SPAN || box.getZsize() > SPATIAL_MAX_SMALL_SPAN) {
+                return OVERFLOW_CELL;
+            }
+            return BlockPos.asLong(
+                Mth.floor((box.minX + box.maxX) * 0.5D),
+                Mth.floor((box.minY + box.maxY) * 0.5D),
+                Mth.floor((box.minZ + box.maxZ) * 0.5D)
+            );
+        }
+    }
+
+    private static final class SpatialBucket<E extends Entity> {
+
+        private Entity[] storage = new Entity[4];
+        private int size;
+
+        void add(final E entity) {
+            if (this.size == this.storage.length) {
+                this.storage = Arrays.copyOf(this.storage, this.storage.length << 1);
+            }
+            this.storage[this.size++] = entity;
+        }
+
+        boolean remove(final E entity) {
+            for (int index = 0; index < this.size; ++index) {
+                if (this.storage[index] != entity) {
+                    continue;
+                }
+                final int last = --this.size;
+                System.arraycopy(this.storage, index + 1, this.storage, index, last - index);
+                this.storage[last] = null;
+                return true;
+            }
+            return false;
+        }
+
+        @SuppressWarnings("unchecked")
+        E get(final int index) {
+            return (E)this.storage[index];
+        }
+
+        boolean isEmpty() {
+            return this.size == 0;
+        }
+    }
