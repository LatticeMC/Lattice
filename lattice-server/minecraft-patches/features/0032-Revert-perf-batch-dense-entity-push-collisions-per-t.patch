Subject: [PATCH] Revert "perf: batch dense entity push collisions per tick"

This reverts commit 65581913564b6124dc1c7ed1bbb7a4a27508ec4b.

diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index ec0f29b520e171f4a21d348aedd4a5c6956baff9..eb16e7099106c19b9ac7e39c21c280852429c8bb 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -861,11 +861,6 @@ public class ServerLevel extends Level implements ServerEntityGetter, WorldGenLe
             }
 
             io.papermc.paper.entity.activation.ActivationRange.activateEntities(this); // Paper - EAR
-            // Dense living-entity pushing asks the same collision question
-            // once per entity. Build its bounded native broad phase once for
-            // this world tick; ordinary-density callers retain the normal
-            // Moonrise lookup path.
-            com.latticemc.lattice.nativelib.NativeCollisionBatch.prepare(this, this.entityTickList);
             this.entityTickList
                 .forEach(
                     entity -> {
diff --git a/net/minecraft/world/level/Level.java b/net/minecraft/world/level/Level.java
index 0e98d9ca93599b8d7084bca7e7903d45901dfea9..287ef75ae2957d727c6467ad053cbc0affab8973 100644
--- a/net/minecraft/world/level/Level.java
+++ b/net/minecraft/world/level/Level.java
@@ -1873,22 +1873,8 @@ public abstract class Level implements LevelAccessor, AutoCloseable, ca.spottedl
      */
     public List<Entity> getPushableEntities(Entity entity, AABB boundingBox, int maxCount) {
         Profiler.get().incrementCounter("getEntities");
-        final Predicate<? super Entity> predicate = EntitySelector.pushableBy(entity);
-
-        if ((Object)this instanceof ServerLevel serverLevel) {
-            final List<Entity> batched = com.latticemc.lattice.nativelib.NativeCollisionBatch.getDensePushableEntities(
-                serverLevel, entity, boundingBox, predicate, maxCount
-            );
-            if (batched != null) {
-                ca.spottedleaf.moonrise.common.PlatformHooks.get().addToGetEntities((Level)(Object)this, entity, boundingBox, predicate, batched);
-                if (batched.size() > maxCount) {
-                    batched.subList(maxCount, batched.size()).clear();
-                }
-                return batched;
-            }
-        }
-
         final List<Entity> ret = new java.util.ArrayList<>(Math.min(maxCount, 16));
+        final Predicate<? super Entity> predicate = EntitySelector.pushableBy(entity);
 
         ((ca.spottedleaf.moonrise.patches.chunk_system.level.ChunkSystemLevel)this).moonrise$getEntityLookup()
             .getEntities(entity, boundingBox, ret, predicate, maxCount);
