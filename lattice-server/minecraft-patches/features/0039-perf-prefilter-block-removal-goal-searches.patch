 public class RemoveBlockGoal extends MoveToBlockGoal {
     private final Block blockToRemove;
+    private final Predicate<BlockState> blockToRemovePredicate;
     private final Mob removerMob;
+    private final int verticalSearchRange;
     private int ticksSinceReachedGoal;
     private static final int WAIT_AFTER_BLOCK_FOUND = 20;
 
     public RemoveBlockGoal(Block blockToRemove, PathfinderMob removerMob, double speedModifier, int searchRange) {
         super(removerMob, speedModifier, 24, searchRange);
         this.blockToRemove = blockToRemove;
+        this.blockToRemovePredicate = state -> state.is(blockToRemove);
         this.removerMob = removerMob;
+        this.verticalSearchRange = searchRange;
     }
 
     @Override
@@ -40,6 +47,9 @@ public class RemoveBlockGoal extends MoveToBlockGoal {
         } else if (this.nextStartTick > 0) {
             this.nextStartTick--;
             return false;
+        } else if (!this.mayHaveBlockToRemoveNearby()) {
+            this.nextStartTick = this.nextStartTick(this.mob);
+            return false;
         } else if (this.findNearestBlock()) {
             this.nextStartTick = reducedTickDelay(20);
             return true;
@@ -49,6 +59,37 @@ public class RemoveBlockGoal extends MoveToBlockGoal {
         }
     }
 
+    private boolean mayHaveBlockToRemoveNearby() {
+        LevelReader level = this.removerMob.level();
+        BlockPos origin = this.removerMob.blockPosition();
+        int minChunkX = (origin.getX() - 23) >> 4;
+        int maxChunkX = (origin.getX() + 23) >> 4;
+        int minChunkZ = (origin.getZ() - 23) >> 4;
+        int maxChunkZ = (origin.getZ() + 23) >> 4;
+        int minSectionY = SectionPos.blockToSectionCoord(origin.getY() - this.verticalSearchRange - 1);
+        int maxSectionY = SectionPos.blockToSectionCoord(origin.getY() + this.verticalSearchRange - 1);
+
+        for (int chunkZ = minChunkZ; chunkZ <= maxChunkZ; chunkZ++) {
+            for (int chunkX = minChunkX; chunkX <= maxChunkX; chunkX++) {
+                ChunkAccess chunk = level.getChunkIfLoadedImmediately(chunkX, chunkZ); // Paper - Prevent AI rules from loading chunks
+                if (chunk == null) {
+                    continue;
+                }
+
+                int fromSectionY = Math.max(minSectionY, chunk.getMinSectionY());
+                int toSectionY = Math.min(maxSectionY, chunk.getMaxSectionY());
+                for (int sectionY = fromSectionY; sectionY <= toSectionY; sectionY++) {
+                    LevelChunkSection section = chunk.getSection(chunk.getSectionIndexFromSectionY(sectionY));
+                    if (!section.hasOnlyAir() && section.maybeHas(this.blockToRemovePredicate)) {
+                        return true;
+                    }
+                }
+            }
+        }
+
+        return false;
+    }
+
     @Override
     public void stop() {
         super.stop();
