+
+    private static final class ArrayGoalSet extends AbstractSet<WrappedGoal> {
+        private static final WrappedGoal[] EMPTY = new WrappedGoal[0];
+        private WrappedGoal[] elements = EMPTY;
+        private int size;
+
+        WrappedGoal[] elements() {
+            return this.elements;
+        }
+
+        @Override
+        public int size() {
+            return this.size;
+        }
+
+        @Override
+        public boolean add(WrappedGoal goal) {
+            Objects.requireNonNull(goal);
+            if (this.contains(goal)) {
+                return false;
+            }
+            if (this.size == this.elements.length) {
+                int capacity = this.elements.length == 0 ? 8 : this.elements.length + (this.elements.length >> 1);
+                this.elements = Arrays.copyOf(this.elements, capacity);
+            }
+            this.elements[this.size++] = goal;
+            return true;
+        }
+
+        @Override
+        public boolean contains(Object object) {
+            for (int i = 0; i < this.size; i++) {
+                if (Objects.equals(this.elements[i], object)) {
+                    return true;
+                }
+            }
+            return false;
+        }
+
+        @Override
+        public boolean remove(Object object) {
+            for (int i = 0; i < this.size; i++) {
+                if (Objects.equals(this.elements[i], object)) {
+                    this.removeAt(i);
+                    return true;
+                }
+            }
+            return false;
+        }
+
+        @Override
+        public boolean removeIf(Predicate<? super WrappedGoal> filter) {
+            Objects.requireNonNull(filter);
+            boolean removed = false;
+            for (int i = this.size - 1; i >= 0; i--) {
+                if (filter.test(this.elements[i])) {
+                    this.removeAt(i);
+                    removed = true;
+                }
+            }
+            return removed;
+        }
+
+        @Override
+        public void clear() {
+            Arrays.fill(this.elements, 0, this.size, null);
+            this.size = 0;
+        }
+
+        @Override
+        public Iterator<WrappedGoal> iterator() {
+            return new Iterator<>() {
+                private int cursor;
+                private int last = -1;
+
+                @Override
+                public boolean hasNext() {
+                    return this.cursor < ArrayGoalSet.this.size;
+                }
+
+                @Override
+                public WrappedGoal next() {
+                    if (!this.hasNext()) {
+                        throw new NoSuchElementException();
+                    }
+                    this.last = this.cursor;
+                    return ArrayGoalSet.this.elements[this.cursor++];
+                }
+
+                @Override
+                public void remove() {
+                    if (this.last < 0) {
+                        throw new IllegalStateException();
+                    }
+                    ArrayGoalSet.this.removeAt(this.last);
+                    this.cursor = this.last;
+                    this.last = -1;
+                }
+            };
+        }
+
+        private void removeAt(int index) {
+            int moved = this.size - index - 1;
+            if (moved > 0) {
+                System.arraycopy(this.elements, index + 1, this.elements, index, moved);
+            }
+            this.elements[--this.size] = null;
+        }
+    }
 }
