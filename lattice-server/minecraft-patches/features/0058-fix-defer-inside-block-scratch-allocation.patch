+            if (sharedTraversalScratch) {
+                if (traversalScratch == null) {
+                    traversalScratch = new LongOpenHashSet(4);
+                    this.insideBlockTraversalScratch = traversalScratch;
+                }
+
+                this.insideBlockTraversalScratchInUse = true;
+            } else {
+                traversalScratch = new LongOpenHashSet(4);
+            }
+            traversalScratch.clear();
+        }
+
         int previousLastVisitedStep = this.insideBlockLastVisitedStep;
         this.insideBlockLastVisitedStep = 0;
-        traversalScratch.clear();
         try {
-            BlockGetter.forEachBlockIntersectedBetween(
-                from,
-                to,
-                aabb,
-                (pos, index) -> {
-                    if (!this.isAlive()) {
-                        return false;
-                    } else if (index >= maxSteps) {
-                        return false;
-                    } else {
-                        this.insideBlockLastVisitedStep = index;
-                        BlockState blockState = this.level().getBlockState(pos);
-                        if (blockState.isAir()) {
-                            if (flag1) {
-                                this.debugBlockIntersection((ServerLevel)this.level(), pos.immutable(), false, false);
-                            }
-
-                            return true;
-                        } else {
-                            VoxelShape entityInsideCollisionShape = blockState.getEntityInsideCollisionShape(this.level(), pos, this);
-                            boolean flag2 = entityInsideCollisionShape == Shapes.block()
