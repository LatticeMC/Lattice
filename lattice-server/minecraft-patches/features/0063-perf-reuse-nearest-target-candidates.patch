From: sweepikun <laomgba@outlook.com>
Date: Sun, 2 Aug 2026 15:42:01 +0800
Subject: [PATCH] perf: reuse nearest target candidates


diff --git a/net/minecraft/world/entity/ai/goal/target/NearestAttackableTargetGoal.java b/net/minecraft/world/entity/ai/goal/target/NearestAttackableTargetGoal.java
index e8dc0eca01cf1a4eb1fe2a799e4dcbe391843318..accc7d0ec75da5951b98a991d7a2991688010f34 100644
--- a/net/minecraft/world/entity/ai/goal/target/NearestAttackableTargetGoal.java
+++ b/net/minecraft/world/entity/ai/goal/target/NearestAttackableTargetGoal.java
@@ -1,5 +1,6 @@
 package net.minecraft.world.entity.ai.goal.target;
 
+import it.unimi.dsi.fastutil.objects.ObjectArrayList;
 import java.util.EnumSet;
 import net.minecraft.server.level.ServerLevel;
 import net.minecraft.server.level.ServerPlayer;
@@ -17,6 +18,8 @@ public class NearestAttackableTargetGoal<T extends LivingEntity> extends TargetG
     protected final int randomInterval;
     protected @Nullable LivingEntity target;
     protected TargetingConditions targetConditions;
+    private final ObjectArrayList<T> targetCandidates = new ObjectArrayList<>();
+    private boolean targetCandidatesInUse;
 
     public NearestAttackableTargetGoal(Mob mob, Class<T> targetType, boolean mustSee) {
         this(mob, targetType, 10, mustSee, false, null);
@@ -57,14 +60,36 @@ public class NearestAttackableTargetGoal<T extends LivingEntity> extends TargetG
     protected void findTarget() {
         ServerLevel serverLevel = getServerLevel(this.mob);
         if (this.targetType != Player.class && this.targetType != ServerPlayer.class) {
-            this.target = serverLevel.getNearestEntity(
-                this.mob.level().getEntitiesOfClass(this.targetType, this.getTargetSearchArea(this.getFollowDistance()), entity -> true),
-                this.getTargetConditions(),
-                this.mob,
-                this.mob.getX(),
-                this.mob.getEyeY(),
-                this.mob.getZ()
-            );
+            final boolean reusable = !this.targetCandidatesInUse;
+            final ObjectArrayList<T> candidates;
+            if (reusable) {
+                this.targetCandidatesInUse = true;
+                candidates = this.targetCandidates;
+            } else {
+                candidates = new ObjectArrayList<>();
+            }
+
+            try {
+                this.mob.level().getEntitiesOfClass(
+                    this.targetType,
+                    this.getTargetSearchArea(this.getFollowDistance()),
+                    entity -> true,
+                    candidates
+                );
+                this.target = serverLevel.getNearestEntity(
+                    candidates,
+                    this.getTargetConditions(),
+                    this.mob,
+                    this.mob.getX(),
+                    this.mob.getEyeY(),
+                    this.mob.getZ()
+                );
+            } finally {
+                candidates.clear();
+                if (reusable) {
+                    this.targetCandidatesInUse = false;
+                }
+            }
         } else {
             this.target = serverLevel.getNearestPlayer(this.getTargetConditions(), this.mob, this.mob.getX(), this.mob.getEyeY(), this.mob.getZ());
         }
diff --git a/net/minecraft/world/level/Level.java b/net/minecraft/world/level/Level.java
