+    // Leaf start - optimize checkInsideBlocks calls
+    private BlockState getInsideBlockState(Level level, BlockPos pos) {
+        int chunkX = pos.getX() >> 4;
+        int chunkZ = pos.getZ() >> 4;
+        long chunkPos = ChunkPos.asLong(chunkX, chunkZ);
+        ChunkAccess chunk = this.insideBlockCachedChunk;
+        if (chunk == null || this.insideBlockCachedChunkPos != chunkPos) {
+            chunk = level.getChunkIfLoaded(chunkX, chunkZ);
+            this.insideBlockCachedChunk = chunk;
+            this.insideBlockCachedChunkPos = chunkPos;
+        }
+
+        // Preserve the original loading behavior when movement reaches an unloaded chunk.
+        return chunk == null ? level.getBlockState(pos) : chunk.getBlockState(pos);
+    }
+    // Leaf end - optimize checkInsideBlocks calls
