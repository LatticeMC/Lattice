+    private static final class CellTable<E extends Entity> {
+
+        private long[] keys;
+        private SpatialBucket<E>[] values;
+        private int mask;
+        private int maxFill;
+        private int size;
+
+        @SuppressWarnings("unchecked")
+        CellTable(final int expectedSize) {
+            final int capacity = HashCommon.arraySize(expectedSize, 0.5F);
+            this.keys = new long[capacity];
+            this.values = (SpatialBucket<E>[])new SpatialBucket[capacity];
+            this.mask = capacity - 1;
+            this.maxFill = capacity >>> 1;
+        }
+
+        SpatialBucket<E> get(final long key) {
+            int position = (int)HashCommon.mix(key) & this.mask;
+            SpatialBucket<E> value;
+            while ((value = this.values[position]) != null) {
+                if (this.keys[position] == key) {
+                    return value;
+                }
+                position = position + 1 & this.mask;
+            }
+            return null;
+        }
+
+        void putNew(final long key, final SpatialBucket<E> value) {
+            if (this.size + 1 > this.maxFill) {
+                this.rehash(this.keys.length << 1);
+            }
+            int position = (int)HashCommon.mix(key) & this.mask;
+            while (this.values[position] != null) {
+                position = position + 1 & this.mask;
+            }
+            this.keys[position] = key;
+            this.values[position] = value;
+            ++this.size;
+        }
+
+        void remove(final long key) {
+            int position = (int)HashCommon.mix(key) & this.mask;
+            SpatialBucket<E> value;
+            while ((value = this.values[position]) != null) {
+                if (this.keys[position] == key) {
+                    --this.size;
+                    this.shiftKeys(position);
+                    return;
+                }
+                position = position + 1 & this.mask;
+            }
+        }
+
+        private void shiftKeys(int position) {
+            final long[] keys = this.keys;
+            final SpatialBucket<E>[] values = this.values;
+            while (true) {
+                final int last = position;
+                position = position + 1 & this.mask;
+                SpatialBucket<E> value;
+                while ((value = values[position]) != null) {
+                    final int slot = (int)HashCommon.mix(keys[position]) & this.mask;
+                    if (last <= position ? last >= slot || slot > position : last >= slot && slot > position) {
+                        break;
+                    }
+                    position = position + 1 & this.mask;
+                }
+                if (value == null) {
+                    values[last] = null;
+                    return;
+                }
+                keys[last] = keys[position];
+                values[last] = value;
+            }
+        }
+
+        @SuppressWarnings("unchecked")
+        private void rehash(final int capacity) {
+            final long[] oldKeys = this.keys;
+            final SpatialBucket<E>[] oldValues = this.values;
+            final long[] newKeys = new long[capacity];
+            final SpatialBucket<E>[] newValues = (SpatialBucket<E>[])new SpatialBucket[capacity];
+            final int newMask = capacity - 1;
+            for (int index = 0; index < oldValues.length; ++index) {
+                final SpatialBucket<E> value = oldValues[index];
+                if (value == null) {
+                    continue;
+                }
+                final long key = oldKeys[index];
+                int position = (int)HashCommon.mix(key) & newMask;
+                while (newValues[position] != null) {
+                    position = position + 1 & newMask;
+                }
+                newKeys[position] = key;
+                newValues[position] = value;
+            }
+            this.keys = newKeys;
+            this.values = newValues;
+            this.mask = newMask;
+            this.maxFill = capacity >>> 1;
+        }
+    }
+
     private static final class SpatialBucket<E extends Entity> {
 
         private Entity[] storage = new Entity[4];
