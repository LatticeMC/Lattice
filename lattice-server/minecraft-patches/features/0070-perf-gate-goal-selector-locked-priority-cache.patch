+    // Leaf start - optimize goal selector
+    private void tickLockedPriorityFastPath() {
+        ProfilerFiller profilerFiller = Profiler.get();
+        profilerFiller.push("goalCleanup");
+
+        WrappedGoal[] goals = this.availableGoals.elements();
+        int goalCount = this.availableGoals.size();
+        long disabledFlags = this.goalTypes.getBackingSet();
+        Map<Goal.Flag, WrappedGoal> lockedFlags = this.lockedFlags;
+        int[] lockedPriorities = this.lockedPriorities;
+        long lockedMask = 0L;
+
+        for (int i = 0; i < goalCount; i++) {
+            WrappedGoal goal = goals[i];
+            if (goal.isRunning() && ((goal.getFlags().getBackingSet() & disabledFlags) != 0L || !goal.canContinueToUse())) {
+                goal.stop();
+            }
+        }
+
+        for (int i = 0; i < GOAL_FLAG_VALUES.length; i++) {
+            Goal.Flag flag = GOAL_FLAG_VALUES[i];
+            WrappedGoal locked = lockedFlags.get(flag);
+            if (locked == null) {
+                lockedPriorities[i] = Integer.MAX_VALUE;
+            } else if (!locked.isRunning()) {
+                lockedFlags.remove(flag);
+                lockedPriorities[i] = Integer.MAX_VALUE;
+            } else {
+                lockedPriorities[i] = locked.isInterruptable() ? locked.getPriority() : Integer.MIN_VALUE;
+                lockedMask |= 1L << i;
+            }
+        }
+
+        profilerFiller.pop();
+        profilerFiller.push("goalUpdate");
+
+        goalLoop:
+        for (int goalIndex = 0; goalIndex < goalCount; goalIndex++) {
+            WrappedGoal goal = goals[goalIndex];
+            if (goal.isRunning()) {
+                continue;
+            }
+
+            long goalFlags = goal.getFlags().getBackingSet();
+            int goalPriority = goal.getPriority();
+            if ((goalFlags & disabledFlags) != 0L) {
+                continue;
+            }
+
+            for (long conflicts = goalFlags & lockedMask; conflicts != 0L; conflicts &= conflicts - 1L) {
+                int flagIndex = Long.numberOfTrailingZeros(conflicts);
+                if (goalPriority >= lockedPriorities[flagIndex]) {
+                    continue goalLoop;
+                }
+            }
+
+            if (!goal.canUse()) {
+                continue;
+            }
+
+            for (long flagIterator = goalFlags; flagIterator != 0L; flagIterator &= flagIterator - 1L) {
+                int flagIndex = Long.numberOfTrailingZeros(flagIterator);
+                Goal.Flag flag = GOAL_FLAG_VALUES[flagIndex];
+                WrappedGoal locked = lockedFlags.get(flag);
+                if (locked != null) {
+                    locked.stop();
+                }
+
+                lockedFlags.put(flag, goal);
+                lockedPriorities[flagIndex] = goal.isInterruptable() ? goalPriority : Integer.MIN_VALUE;
+                lockedMask |= 1L << flagIndex;
+            }
+
+            goal.start();
+        }
+
+        profilerFiller.pop();
+        this.tickRunningGoals(true);
+    }
+    // Leaf end - optimize goal selector
+
