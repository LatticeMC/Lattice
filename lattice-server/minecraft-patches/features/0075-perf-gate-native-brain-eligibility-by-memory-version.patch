+    private NativeEligibilityPlan latticeNativeEligibilityPlan() {
+        if (this.latticeNativeEligibilityPlan == null) {
+            this.latticeNativeEligibilityPlan = NativeEligibilityPlan.build(this.activeBehaviorGroups(), this.memories);
+        }
+        return this.latticeNativeEligibilityPlan;
+    }
+
+    private static final class NativeEligibilityPlan {
+        private static final NativeEligibilityPlan DISABLED = new NativeEligibilityPlan(null, new int[0], new long[0]);
+        private final NativeBrainEligibility.PackedBatch batch;
+        private final int[] nativeIndexByFlattenedBehavior;
+        private final long[] output;
+
+        private NativeEligibilityPlan(NativeBrainEligibility.PackedBatch batch,
+                                      int[] nativeIndexByFlattenedBehavior, long[] output) {
+            this.batch = batch;
+            this.nativeIndexByFlattenedBehavior = nativeIndexByFlattenedBehavior;
+            this.output = output;
+        }
+
+        private boolean enabled() {
+            return this.batch != null;
+        }
+
+        private NativeBrainEligibility.PackedBatch batch() {
+            return this.batch;
+        }
+
+        private long[] output() {
+            return this.output;
+        }
+
+        private int nativeIndexAt(int flattenedBehavior) {
+            return flattenedBehavior < this.nativeIndexByFlattenedBehavior.length
+                ? this.nativeIndexByFlattenedBehavior[flattenedBehavior] : -1;
+        }
+
+        private void refreshMemoryBits(Map<MemoryModuleType<?>, Optional<? extends ExpirableValue<?>>> memories) {
+            long[] registered = this.batch.registeredMemoryBits();
+            long[] present = this.batch.presentMemoryBits();
+            Arrays.fill(registered, 0L);
+            Arrays.fill(present, 0L);
+            for (Entry<MemoryModuleType<?>, Optional<? extends ExpirableValue<?>>> entry : memories.entrySet()) {
+                int id = BuiltInRegistries.MEMORY_MODULE_TYPE.getId(entry.getKey());
+                if (id >= 0) {
+                    long bit = 1L << (id & 63);
+                    registered[id >>> 6] |= bit;
+                    if (entry.getValue().isPresent()) {
+                        present[id >>> 6] |= bit;
+                    }
+                }
+            }
+        }
+
+        private static <T extends LivingEntity> NativeEligibilityPlan build(
+                BehaviorControlArraySet<? super T>[] groups,
+                Map<MemoryModuleType<?>, Optional<? extends ExpirableValue<?>>> memories) {
+            int flattenedCount = 0;
+            int nativeCount = 0;
+            int requirementCount = 0;
+            for (BehaviorControlArraySet<? super T> group : groups) {
+                BehaviorControl<? super T>[] raw = group.raw();
+                flattenedCount += group.size();
+                for (int i = 0; i < group.size(); i++) {
+                    if (raw[i] instanceof Behavior<?> behavior) {
+                        nativeCount++;
+                        requirementCount += behavior.latticeEntryCondition().size();
+                    }
+                }
+            }
+            int memoryTypeCount = BuiltInRegistries.MEMORY_MODULE_TYPE.size();
+            int memoryWords = (memoryTypeCount + 63) >>> 6;
+            if (!NativeBrainEligibility.shouldUseNative(nativeCount, requirementCount, memoryWords)) {
+                int[] disabled = new int[flattenedCount];
+                Arrays.fill(disabled, -1);
+                return new NativeEligibilityPlan(null, disabled, new long[0]);
+            }
+            long[] registered = new long[memoryWords];
+            for (MemoryModuleType<?> type : memories.keySet()) {
+                int id = BuiltInRegistries.MEMORY_MODULE_TYPE.getId(type);
+                if (id < 0) return DISABLED;
+                registered[id >>> 6] |= 1L << (id & 63);
+            }
+            int[] nativeIndexByFlat = new int[flattenedCount];
+            Arrays.fill(nativeIndexByFlat, -1);
+            int[] behaviorEntities = new int[nativeCount];
+            int[] offsets = new int[nativeCount + 1];
+            int[] memoryIds = new int[requirementCount];
+            byte[] statuses = new byte[requirementCount];
+            int flat = 0;
+            int nativeIndex = 0;
+            int requirement = 0;
+            for (BehaviorControlArraySet<? super T> group : groups) {
+                BehaviorControl<? super T>[] raw = group.raw();
+                for (int i = 0; i < group.size(); i++, flat++) {
+                    if (raw[i] instanceof Behavior<?> behavior) {
+                        nativeIndexByFlat[flat] = nativeIndex;
+                        offsets[nativeIndex] = requirement;
+                        for (Entry<MemoryModuleType<?>, MemoryStatus> condition : behavior.latticeEntryCondition().entrySet()) {
+                            int id = BuiltInRegistries.MEMORY_MODULE_TYPE.getId(condition.getKey());
+                            if (id < 0) return DISABLED;
+                            memoryIds[requirement] = id;
+                            statuses[requirement] = switch (condition.getValue()) {
+                                case VALUE_PRESENT -> NativeBrainEligibility.VALUE_PRESENT;
+                                case VALUE_ABSENT -> NativeBrainEligibility.VALUE_ABSENT;
+                                case REGISTERED -> NativeBrainEligibility.REGISTERED;
+                            };
+                            requirement++;
+                        }
+                        nativeIndex++;
+                    }
+                }
+            }
+            offsets[nativeCount] = requirement;
+            NativeBrainEligibility.Batch csr = new NativeBrainEligibility.Batch(
+                    1, memoryTypeCount, registered, new long[memoryWords], behaviorEntities,
+                    offsets, memoryIds, statuses);
+            return new NativeEligibilityPlan(NativeBrainEligibility.pack(csr), nativeIndexByFlat,
+                    new long[(nativeCount + 63) >>> 6]);
+        }
+    }
     private boolean isEmptyCollection(Object collection) {
         return collection instanceof Collection && ((Collection)collection).isEmpty();
     }
