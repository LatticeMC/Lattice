+    /**
+     * Lattice - Native brain eligibility: starts this behavior after its
+     * entryCondition was checked against the current Brain memory version.
+     * The caller must invalidate the result when an earlier behavior changes memory.
+     */
+    public final boolean tryStartWithMemoryEligibility(ServerLevel level, E owner, long gameTime) {
+        int tickRate = java.util.Objects.requireNonNullElse(level.paperConfig().tickRates.behavior.get(owner.getType(), this.configKey), -1);
+        if (tickRate > -1 && gameTime < this.endTimestamp + tickRate) {
+            return false;
+        }
+        if (this.checkExtraStartConditions(level, owner)) {
+            this.status = Behavior.Status.RUNNING;
+            int i = this.minDuration + level.getRandom().nextInt(this.maxDuration + 1 - this.minDuration);
+            this.endTimestamp = gameTime + i;
+            this.start(level, owner, gameTime);
+            return true;
+        }
+        return false;
+    }
+
+    /** Lattice - Native brain eligibility: immutable descriptor for batch materialization. */
+    public final Map<MemoryModuleType<?>, MemoryStatus> latticeEntryCondition() {
+        return this.entryCondition;
+    }
     protected void start(ServerLevel level, E entity, long gameTime) {
     }
 
