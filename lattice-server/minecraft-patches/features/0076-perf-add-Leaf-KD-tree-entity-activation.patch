+    // Lattice start - Leaf: optimize entity activation with a KD-tree
+    // Original author: hayanesuru <hayanesuru@outlook.jp>
+    // Original license: MIT
+    // Source: https://github.com/Winds-Studio/Leaf/commit/1f36f102062075e770fb3e2aa53ea5301e3da888
+    public final void lattice$getEntitiesForActivation(final AABB box, final it.unimi.dsi.fastutil.longs.LongOpenHashSet chunkSet, final it.unimi.dsi.fastutil.objects.ObjectArrayList<Entity> into) {
+        final int minChunkX = (Mth.floor(box.minX) - 2) >> 4;
+        final int minChunkZ = (Mth.floor(box.minZ) - 2) >> 4;
+        final int maxChunkX = (Mth.floor(box.maxX) + 2) >> 4;
+        final int maxChunkZ = (Mth.floor(box.maxZ) + 2) >> 4;
+
+        final int minRegionX = minChunkX >> REGION_SHIFT;
+        final int minRegionZ = minChunkZ >> REGION_SHIFT;
+        final int maxRegionX = maxChunkX >> REGION_SHIFT;
+        final int maxRegionZ = maxChunkZ >> REGION_SHIFT;
+
+        for (int regionZ = minRegionZ; regionZ <= maxRegionZ; regionZ++) {
+            final int minZ = regionZ == minRegionZ ? minChunkZ & REGION_MASK : 0;
+            final int maxZ = regionZ == maxRegionZ ? maxChunkZ & REGION_MASK : REGION_MASK;
+            for (int regionX = minRegionX; regionX <= maxRegionX; regionX++) {
+                final ChunkSlicesRegion region = this.getRegion(regionX, regionZ);
+                if (region == null) {
+                    continue;
+                }
+                final int minX = regionX == minRegionX ? minChunkX & REGION_MASK : 0;
+                final int maxX = regionX == maxRegionX ? maxChunkX & REGION_MASK : REGION_MASK;
+                for (int chunkZ = minZ; chunkZ <= maxZ; chunkZ++) {
+                    for (int chunkX = minX; chunkX <= maxX; chunkX++) {
+                        final ChunkEntitySlices chunk = region.get(chunkX | (chunkZ << REGION_SHIFT));
+                        if (chunk == null || !chunk.status.isOrAfter(FullChunkStatus.FULL)) {
+                            continue;
+                        }
+                        final int absoluteChunkX = (regionX << REGION_SHIFT) | chunkX;
+                        final int absoluteChunkZ = (regionZ << REGION_SHIFT) | chunkZ;
+                        if (chunkSet.add(CoordinateUtils.getChunkKey(absoluteChunkX, absoluteChunkZ))) {
+                            chunk.lattice$getAllEntitiesForActivation(into);
+                        }
+                    }
+                }
+            }
+        }
+    }
+    // Lattice end - Leaf: optimize entity activation with a KD-tree
+
