+    /**
+     * Streams candidates for {@link net.minecraft.world.entity.LivingEntity#pushEntities()} only.
+     * Moonrise keeps its normal region and section order; plugin-supplied entities retain their
+     * existing {@code PlatformHooks.addToGetEntities} order after the Moonrise traversal.
+     */
+    public final boolean lattice$forEachPushableEntity(final Entity except, final AABB boundingBox,
+                                                        final Predicate<? super Entity> predicate,
+                                                        final AbortableIterationConsumer<Entity> consumer) {
+        Profiler.get().incrementCounter("getEntities");
+        if (((ca.spottedleaf.moonrise.patches.chunk_system.level.ChunkSystemLevel)this).moonrise$getEntityLookup()
+            .forEachEntity(except, boundingBox, predicate, consumer)) {
+            return true;
+        }
+
+        final List<Entity> platformEntities = new java.util.ArrayList<>();
+        ca.spottedleaf.moonrise.common.PlatformHooks.get().addToGetEntities(
+            (Level)(Object)this, except, boundingBox, predicate, platformEntities
+        );
+        for (int index = 0, size = platformEntities.size(); index < size; ++index) {
+            if (consumer.accept(platformEntities.get(index)).shouldAbort()) {
+                return true;
+            }
+        }
+        return false;
+    }
+    // Lattice end - Leaf: limit pushable entity queries
