+        public boolean forEachEntity(final Entity except, final AABB box, final Predicate<? super Entity> predicate,
+                                     final AbortableIterationConsumer<Entity> consumer) {
+            if (this.count == 0) {
+                return false;
+            }
+
+            final int minSection = this.slices.minSection;
+            final int maxSection = this.slices.maxSection;
+            final int min = Mth.clamp(Mth.floor(box.minY - 2.0) >> 4, minSection, maxSection);
+            final int max = Mth.clamp(Mth.floor(box.maxY + 2.0) >> 4, minSection, maxSection);
+
+            for (int section = min; section <= max; ++section) {
+                final BasicEntityList<Entity> list = this.entitiesBySection[section - minSection];
+                if (list == null) {
+                    continue;
+                }
+
+                final Entity[] storage = list.storage;
+                for (int i = 0, len = Math.min(storage.length, list.size()); i < len; ++i) {
+                    final Entity entity = storage[i];
+                    if (entity == null || entity == except || !entity.getBoundingBox().intersects(box)) {
+                        continue;
+                    }
+                    if (predicate != null && !predicate.test(entity)) {
+                        continue;
+                    }
+                    if (consumer.accept(entity).shouldAbort()) {
+                        return true;
+                    }
+                }
+            }
+            return false;
+        }
+        // Lattice end - Leaf: limit pushable entity queries
