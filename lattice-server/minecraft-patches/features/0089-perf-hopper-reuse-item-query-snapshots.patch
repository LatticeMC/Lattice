     public static List<ItemEntity> getItemsAtAndAbove(Level level, Hopper hopper) {
+        List<ItemEntity> items = new ArrayList<>();
+        getItemsAtAndAbove(level, hopper, items);
+        return items;
+    }
+
+    private static void getItemsAtAndAbove(Level level, Hopper hopper, List<ItemEntity> into) {
         AABB aabb = hopper.getSuckAabb().move(hopper.getLevelX() - 0.5, hopper.getLevelY() - 0.5, hopper.getLevelZ() - 0.5);
-        return level.getEntitiesOfClass(ItemEntity.class, aabb, EntitySelector.ENTITY_STILL_ALIVE);
+        level.getEntitiesOfClass(ItemEntity.class, aabb, EntitySelector.ENTITY_STILL_ALIVE, into);
+    }
+
+    static final class ItemEntityQueryScratch {
+        private final List<ArrayList<ItemEntity>> lists = new ArrayList<>();
+        private int depth;
+
+        List<ItemEntity> acquire() {
+            ArrayList<ItemEntity> list;
+            if (this.depth == this.lists.size()) {
+                list = new ArrayList<>();
+                this.lists.add(list);
+            } else {
+                list = this.lists.get(this.depth);
+            }
+
+            ++this.depth;
+            return list;
+        }
+
+        void release() {
+            ArrayList<ItemEntity> list = this.lists.get(--this.depth);
+            if (list.size() > RETAINED_ITEM_QUERY_CAPACITY) {
+                this.lists.set(this.depth, new ArrayList<>());
+            } else {
+                list.clear();
+            }
+
+            if (this.depth == 0 && this.lists.size() > RETAINED_ITEM_QUERY_DEPTH) {
+                this.lists.subList(RETAINED_ITEM_QUERY_DEPTH, this.lists.size()).clear();
+            }
+        }
     }
 
