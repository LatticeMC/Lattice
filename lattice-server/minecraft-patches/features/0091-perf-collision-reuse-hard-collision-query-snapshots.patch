@@ -41,6 +41,7 @@ import net.minecraft.world.phys.shapes.OffsetDoubleList;
 import net.minecraft.world.phys.shapes.Shapes;
 import net.minecraft.world.phys.shapes.SliceShape;
 import net.minecraft.world.phys.shapes.VoxelShape;
+import java.util.ArrayList;
 import java.util.Arrays;
 import java.util.List;
 import java.util.Objects;
@@ -51,6 +52,9 @@ public final class CollisionUtil {
 
     public static final double COLLISION_EPSILON = 1.0E-7;
     public static final DoubleArrayList ZERO_ONE = DoubleArrayList.wrap(new double[] { 0.0, 1.0 });
+    private static final int RETAINED_HARD_COLLISION_QUERY_CAPACITY = 256;
+    private static final int RETAINED_HARD_COLLISION_QUERY_DEPTH = 4;
+    private static final ThreadLocal<HardCollisionQueryScratch> HARD_COLLISION_QUERY_SCRATCH = ThreadLocal.withInitial(HardCollisionQueryScratch::new);
 
     public static boolean isSpecialCollidingBlock(final net.minecraft.world.level.block.state.BlockBehaviour.BlockStateBase block) {
         return block.hasLargeCollisionShape() || block.getBlock() == Blocks.MOVING_PISTON;
@@ -2133,6 +2137,25 @@ public final class CollisionUtil {
         // Vanilla for hard collisions has this backwards, and they expand by +epsilon but this causes terrible problems
         // specifically with boat collisions.
         aabb = aabb.inflate(-COLLISION_EPSILON, -COLLISION_EPSILON, -COLLISION_EPSILON);
+        if (checkOnly && into == null && (entity == null || !((ChunkSystemEntity)entity).moonrise$isHardColliding())) {
+            final HardCollisionQueryScratch scratch = HARD_COLLISION_QUERY_SCRATCH.get();
+            final List<Entity> entities = scratch.acquire();
+            try {
+                // Keep the complete Moonrise snapshot before calling entity collision methods.
+                world.lattice$getHardCollidingEntities(entity, aabb, predicate, entities);
+                for (int i = 0, len = entities.size(); i < len; ++i) {
+                    final Entity otherEntity = entities.get(i);
+                    if (!otherEntity.isSpectator()
+                        && ((entity == null && otherEntity.canBeCollidedWith(entity)) || (entity != null && entity.canCollideWith(otherEntity)))) {
+                        return true;
+                    }
+                }
+                return false;
+            } finally {
+                scratch.release();
+            }
+        }
+
         final List<Entity> entities;
         if (entity != null && ((ChunkSystemEntity)entity).moonrise$isHardColliding()) {
             entities = world.getEntities(entity, aabb, predicate);
@@ -2160,6 +2183,33 @@ public final class CollisionUtil {
         return ret;
     }
 
+    static final class HardCollisionQueryScratch {
+
+        private final List<ArrayList<Entity>> lists = new ArrayList<>(RETAINED_HARD_COLLISION_QUERY_DEPTH);
+        private int depth;
+
+        List<Entity> acquire() {
+            final int index = this.depth++;
+            if (index == this.lists.size()) {
+                this.lists.add(new ArrayList<>());
+            }
+            return this.lists.get(index);
+        }
+
+        void release() {
+            final int index = --this.depth;
+            final ArrayList<Entity> list = this.lists.get(index);
+            if (list.size() > RETAINED_HARD_COLLISION_QUERY_CAPACITY) {
+                this.lists.set(index, new ArrayList<>());
+            } else {
+                list.clear();
+            }
+            if (this.depth == 0 && this.lists.size() > RETAINED_HARD_COLLISION_QUERY_DEPTH) {
+                this.lists.subList(RETAINED_HARD_COLLISION_QUERY_DEPTH, this.lists.size()).clear();
+            }
+        }
+    }
+
     public static boolean getCollisions(final Level world, final Entity entity, final AABB aabb,
                                         final List<VoxelShape> intoVoxel, final List<AABB> intoAABB, final int collisionFlags,
                                         final BiPredicate<BlockState, BlockPos> blockPredicate,
