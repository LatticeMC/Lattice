+    /**
+     * Hot interpolation state stored by interpolator-array index rather than in
+     * scattered {@link NoiseInterpolator} objects.  Every operation deliberately
+     * keeps the vanilla {@link Mth#lerp} / {@link Mth#lerp3} call order.
+     */
+    static final class InterpolationState {
+        final double[] noise000;
+        final double[] noise001;
+        final double[] noise100;
+        final double[] noise101;
+        final double[] noise010;
+        final double[] noise011;
+        final double[] noise110;
+        final double[] noise111;
+        final double[] valueXZ00;
+        final double[] valueXZ10;
+        final double[] valueXZ01;
+        final double[] valueXZ11;
+        final double[] valueZ0;
+        final double[] valueZ1;
+        final double[] value;
+
+        InterpolationState(int interpolatorCount) {
+            this.noise000 = new double[interpolatorCount];
+            this.noise001 = new double[interpolatorCount];
+            this.noise100 = new double[interpolatorCount];
+            this.noise101 = new double[interpolatorCount];
+            this.noise010 = new double[interpolatorCount];
+            this.noise011 = new double[interpolatorCount];
+            this.noise110 = new double[interpolatorCount];
+            this.noise111 = new double[interpolatorCount];
+            this.valueXZ00 = new double[interpolatorCount];
+            this.valueXZ10 = new double[interpolatorCount];
+            this.valueXZ01 = new double[interpolatorCount];
+            this.valueXZ11 = new double[interpolatorCount];
+            this.valueZ0 = new double[interpolatorCount];
+            this.valueZ1 = new double[interpolatorCount];
+            this.value = new double[interpolatorCount];
+        }
+
+        void selectCellYZ(
+            int index,
+            double noise000,
+            double noise001,
+            double noise100,
+            double noise101,
+            double noise010,
+            double noise011,
+            double noise110,
+            double noise111
+        ) {
+            this.noise000[index] = noise000;
+            this.noise001[index] = noise001;
+            this.noise100[index] = noise100;
+            this.noise101[index] = noise101;
+            this.noise010[index] = noise010;
+            this.noise011[index] = noise011;
+            this.noise110[index] = noise110;
+            this.noise111[index] = noise111;
+        }
+
+        void updateForY(double y) {
+            for (int index = 0; index < this.value.length; index++) {
+                this.valueXZ00[index] = Mth.lerp(y, this.noise000[index], this.noise010[index]);
+                this.valueXZ10[index] = Mth.lerp(y, this.noise100[index], this.noise110[index]);
+                this.valueXZ01[index] = Mth.lerp(y, this.noise001[index], this.noise011[index]);
+                this.valueXZ11[index] = Mth.lerp(y, this.noise101[index], this.noise111[index]);
+            }
+        }
+
+        void updateForX(double x) {
+            for (int index = 0; index < this.value.length; index++) {
+                this.valueZ0[index] = Mth.lerp(x, this.valueXZ00[index], this.valueXZ10[index]);
+                this.valueZ1[index] = Mth.lerp(x, this.valueXZ01[index], this.valueXZ11[index]);
+            }
+        }
+
+        void updateForZ(double z) {
+            for (int index = 0; index < this.value.length; index++) {
+                this.value[index] = Mth.lerp(z, this.valueZ0[index], this.valueZ1[index]);
+            }
+        }
+
+        double computeFillingCell(int index, double x, double y, double z) {
+            return Mth.lerp3(
+                x,
+                y,
+                z,
+                this.noise000[index],
+                this.noise100[index],
+                this.noise010[index],
+                this.noise110[index],
+                this.noise001[index],
+                this.noise101[index],
+                this.noise011[index],
+                this.noise111[index]
+            );
+        }
+    }
+
