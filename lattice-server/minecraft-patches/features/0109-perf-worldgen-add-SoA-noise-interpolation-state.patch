+        void lattice$selectCellYZInto(InterpolationState interpolationState, int index, int y, int z) {
+            if (this.interpolationIndex != index) {
+                throw new IllegalStateException("Noise interpolator index changed after construction");
+            }
+            if (this.flatReadable) {
+                int yRows = NoiseChunk.this.cellCountY + 1;
+                int zRows = NoiseChunk.this.cellCountXZ + 1;
+                double[] start = this.ensureFlatSlice(true, yRows * zRows);
+                double[] end = this.ensureFlatSlice(false, yRows * zRows);
+                int i00 = z * yRows + y;
+                int i10 = (z + 1) * yRows + y;
+                int i01 = z * yRows + y + 1;
+                int i11 = (z + 1) * yRows + y + 1;
+                if (i11 < start.length && i11 < end.length) {
+                    long profileStart = WorldgenProfiler.hotLoopStart();
+                    interpolationState.selectCellYZ(
+                        index,
+                        start[i00],
+                        start[i10],
+                        end[i00],
+                        end[i10],
+                        start[i01],
+                        start[i11],
+                        end[i01],
+                        end[i11]
+                    );
+                    WorldgenProfiler.end(WorldgenProfiler.NOISE_INTERPOLATOR_SELECT_CELL_YZ_FLAT, profileStart);
+                    return;
+                }
+            }
+
+            interpolationState.selectCellYZ(
+                index,
+                this.slice0[z][y],
+                this.slice0[z + 1][y],
+                this.slice1[z][y],
+                this.slice1[z + 1][y],
+                this.slice0[z][y + 1],
+                this.slice0[z + 1][y + 1],
+                this.slice1[z][y + 1],
+                this.slice1[z + 1][y + 1]
+            );
+        }
+
         void updateForY(double y) {
             this.valueXZ00 = Mth.lerp(y, this.noise000, this.noise010);
             this.valueXZ10 = Mth.lerp(y, this.noise100, this.noise110);
@@ -1260,6 +1432,17 @@ public class NoiseChunk implements DensityFunction.ContextProvider, DensityFunct
             } else if (!NoiseChunk.this.interpolating) {
                 throw new IllegalStateException("Trying to sample interpolator outside the interpolation loop");
             } else {
+                if (LATTICE_SOA_INTERPOLATION) {
