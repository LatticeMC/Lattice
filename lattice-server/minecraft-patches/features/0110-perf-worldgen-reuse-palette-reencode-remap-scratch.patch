Subject: [PATCH] perf(worldgen): reuse palette reencode remap scratch


diff --git a/net/minecraft/world/level/chunk/PalettedContainer.java b/net/minecraft/world/level/chunk/PalettedContainer.java
index 3e8a62313b6c3a6ff1f8686101e934c836d8d24d..0cc9baa5bcb808f068dc9626738e60b09f5ef383 100644
--- a/net/minecraft/world/level/chunk/PalettedContainer.java
+++ b/net/minecraft/world/level/chunk/PalettedContainer.java
@@ -24,6 +24,9 @@ import org.jspecify.annotations.Nullable;
 
 public class PalettedContainer<T> implements PaletteResize<T>, PalettedContainerRO<T> {
     private static final int MIN_PALETTE_BITS = 0;
+    private static final int MAX_CACHED_REENCODE_REMAP_LENGTH = 1 << 12;
+    private static final int MAX_CACHED_REENCODE_DEPTH = 4;
+    private static final ThreadLocal<ReencodeScratchStack> REENCODE_SCRATCH = ThreadLocal.withInitial(ReencodeScratchStack::new);
     public volatile PalettedContainer.Data<T> data; // Paper - optimise collisions - public
     private final Strategy<T> strategy;
     private final T @org.jetbrains.annotations.Nullable [] presetValues; // Paper - Anti-Xray - Add preset values
@@ -363,27 +366,76 @@ public class PalettedContainer<T> implements PaletteResize<T>, PalettedContainer
         return var14;
     }
 
-    private static <T> int[] reencodeContents(BitStorage bitStorage, Palette<T> oldPalette, Palette<T> newPalette) {
+    @VisibleForTesting
+    static <T> int[] reencodeContents(BitStorage bitStorage, Palette<T> oldPalette, Palette<T> newPalette) {
         int[] ints = new int[bitStorage.getSize()];
         bitStorage.unpack(ints);
         PaletteResize<T> paletteResize = PaletteResize.noResizeExpected();
-        int[] remap = new int[oldPalette.getSize()];
-        Arrays.fill(remap, -1);
-
-        for (int i = 0; i < ints.length; i++) {
-            int paletteId = ints[i];
-            int remappedId = remap[paletteId];
-            if (remappedId < 0) {
-                remappedId = newPalette.idFor(oldPalette.valueFor(paletteId), paletteResize);
-                remap[paletteId] = remappedId;
-            }
+        ReencodeScratchStack scratchStack = REENCODE_SCRATCH.get();
+        ReencodeScratch scratch = scratchStack.acquire();
+        try {
+            int[] remap = scratch.remapFor(oldPalette.getSize());
+
+            for (int i = 0; i < ints.length; i++) {
+                int paletteId = ints[i];
+                int remappedId = remap[paletteId];
+                if (remappedId < 0) {
+                    remappedId = newPalette.idFor(oldPalette.valueFor(paletteId), paletteResize);
+                    remap[paletteId] = remappedId;
+                }
 
-            ints[i] = remappedId;
+                ints[i] = remappedId;
+            }
+        } finally {
+            scratchStack.release();
         }
 
         return ints;
     }
 
+    private static final class ReencodeScratchStack {
+        private final ReencodeScratch[] cached = new ReencodeScratch[MAX_CACHED_REENCODE_DEPTH];
+        private int depth;
+
+        ReencodeScratch acquire() {
+            int index = this.depth++;
+            if (index >= MAX_CACHED_REENCODE_DEPTH) {
+                return new ReencodeScratch();
+            }
+
+            ReencodeScratch scratch = this.cached[index];
+            if (scratch == null) {
+                scratch = new ReencodeScratch();
+                this.cached[index] = scratch;
+            }
+
+            return scratch;
+        }
+
+        void release() {
+            this.depth--;
+        }
+    }
+
+    private static final class ReencodeScratch {
+        private @Nullable int[] remap;
+
+        int[] remapFor(int length) {
+            if (length < 0 || length > MAX_CACHED_REENCODE_REMAP_LENGTH) {
+                int[] remap = new int[length];
+                Arrays.fill(remap, -1);
+                return remap;
+            }
+
+            if (this.remap == null || this.remap.length < length) {
+                this.remap = new int[length];
+            }
+
+            Arrays.fill(this.remap, 0, length, -1);
+            return this.remap;
+        }
+    }
+
     @Override
     public int getSerializedSize() {
         return this.data.getSerializedSize(this.strategy.globalMap());
