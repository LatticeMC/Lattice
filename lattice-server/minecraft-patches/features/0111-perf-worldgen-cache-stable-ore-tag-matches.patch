 package net.minecraft.world.level.levelgen.structure.templatesystem;
 
 import com.mojang.serialization.MapCodec;
+import java.util.concurrent.atomic.AtomicReferenceArray;
+import net.minecraft.core.MappedRegistry;
 import net.minecraft.core.registries.Registries;
 import net.minecraft.tags.TagKey;
 import net.minecraft.util.RandomSource;
@@ -9,7 +11,12 @@ import net.minecraft.world.level.block.state.BlockState;
 
 public class TagMatchTest extends RuleTest {
     public static final MapCodec<TagMatchTest> CODEC = TagKey.codec(Registries.BLOCK).fieldOf("tag").xmap(TagMatchTest::new, tagMatchTest -> tagMatchTest.tag);
+    // Ore generation repeatedly checks a small set of immutable block states against the same
+    // tag. A direct-mapped table avoids a ReferenceOpenHashSet probe on a hit while keeping
+    // memory bounded for every data-pack supplied RuleTest instance.
+    private static final int LATTICE_STATE_CACHE_MASK = 31;
     private final TagKey<Block> tag;
+    private volatile AtomicReferenceArray<CacheEntry> lattice$oreStateMatches;
 
     public TagMatchTest(TagKey<Block> tag) {
         this.tag = tag;
@@ -20,6 +27,50 @@ public class TagMatchTest extends RuleTest {
         return state.is(this.tag);
     }
 
+    /**
+     * OreFeature only calls this for an exact TagMatchTest, never a subclass that could have
+     * changed {@link #test(BlockState, RandomSource)} semantics or random consumption.
+     */
+    public boolean lattice$testCachedForOre(BlockState state) {
+        // Lattice start - cache stable block tag memberships for ore placement
+        final long tagEpoch = MappedRegistry.blockTagUpdateEpoch();
+        if ((tagEpoch & 1L) != 0L) {
+            return state.is(this.tag);
+        }
+
+        final int slot = System.identityHashCode(state) & LATTICE_STATE_CACHE_MASK;
+        AtomicReferenceArray<CacheEntry> cache = this.lattice$oreStateMatches;
+        if (cache == null) {
+            cache = new AtomicReferenceArray<>(LATTICE_STATE_CACHE_MASK + 1);
+            this.lattice$oreStateMatches = cache;
+        }
+        final CacheEntry cached = cache.get(slot);
+        if (cached != null && cached.epoch == tagEpoch && cached.state == state) {
+            return cached.matches;
+        }
+
+        final boolean matches = state.is(this.tag);
+        // Do not publish a result that could have been observed while a datapack reload was
+        // replacing holder tags. The test result itself remains the vanilla result.
+        if (MappedRegistry.blockTagUpdateEpoch() == tagEpoch) {
+            cache.lazySet(slot, new CacheEntry(tagEpoch, state, matches));
+        }
+        return matches;
+        // Lattice end - cache stable block tag memberships for ore placement
+    }
+
+    private static final class CacheEntry {
+        private final long epoch;
+        private final BlockState state;
+        private final boolean matches;
+
+        private CacheEntry(long epoch, BlockState state, boolean matches) {
+            this.epoch = epoch;
+            this.state = state;
+            this.matches = matches;
+        }
+    }
+
     @Override
     protected RuleTestType<?> getType() {
         return RuleTestType.TAG_TEST;
