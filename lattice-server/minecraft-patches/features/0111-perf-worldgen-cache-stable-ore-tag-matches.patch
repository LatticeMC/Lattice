 public class MappedRegistry<T> implements WritableRegistry<T> {
+    // Lattice start - invalidate direct-mapped BlockState tag caches across datapack reloads
+    // An odd value means the block tag bindings are currently being replaced. Readers must
+    // not cache memberships during that window because Holder.Reference tags are updated one
+    // state at a time. The even values before and after the window are distinct generations.
+    private static final AtomicLong BLOCK_TAG_UPDATE_EPOCH = new AtomicLong();
+    private static final Object BLOCK_TAG_UPDATE_LOCK = new Object();
+    private static int blockTagUpdateDepth;
+
+    public static long blockTagUpdateEpoch() {
+        return BLOCK_TAG_UPDATE_EPOCH.get();
+    }
+
+    private static void beginBlockTagUpdate() {
+        synchronized (BLOCK_TAG_UPDATE_LOCK) {
+            if (blockTagUpdateDepth++ == 0) {
+                BLOCK_TAG_UPDATE_EPOCH.incrementAndGet();
+            }
+        }
+    }
+
+    private static void endBlockTagUpdate() {
+        synchronized (BLOCK_TAG_UPDATE_LOCK) {
+            if (--blockTagUpdateDepth == 0) {
+                BLOCK_TAG_UPDATE_EPOCH.incrementAndGet();
+            }
+        }
+    }
+    // Lattice end - invalidate direct-mapped BlockState tag caches across datapack reloads
+
     private final ResourceKey<? extends Registry<T>> key;
