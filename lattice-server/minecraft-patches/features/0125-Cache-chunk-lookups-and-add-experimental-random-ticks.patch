From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sweepikun <laomgba@outlook.com>
Date: Mon, 5 Oct 2026 12:00:00 +0800
Subject: [PATCH] Cache chunk lookups and add experimental random ticks


diff --git a/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/ChunkHolderManager.java b/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/ChunkHolderManager.java
index 41b4c5a87b5153f845421a7df8df04c9231253a8..9e16f77abafd66a2508c0b9263d8c940e8211d2f 100644
--- a/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/ChunkHolderManager.java
+++ b/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/ChunkHolderManager.java
@@ -80,10 +80,19 @@ public final class ChunkHolderManager {
     final ChunkUnloadQueue unloadQueue;
 
     private final ConcurrentLong2ReferenceChainedHashTable<NewChunkHolder> chunkHolders = ConcurrentLong2ReferenceChainedHashTable.createWithCapacity(16384, 0.25f);
+    private final com.latticemc.lattice.util.ChunkCache<NewChunkHolder> lattice$holderCache = com.latticemc.lattice.util.ChunkCache.ENABLED ? new com.latticemc.lattice.util.ChunkCache<>(Thread.currentThread(), this.chunkHolders::get) : null;
     private final ServerLevel world;
     private final ChunkTaskScheduler taskScheduler;
     private long currentTick;
 
+    public void lattice$beginTick() {
+        if (this.lattice$holderCache != null) this.lattice$holderCache.beginTick();
+    }
+
+    public void lattice$endTick() {
+        if (this.lattice$holderCache != null) this.lattice$holderCache.endTick();
+    }
+
     private final ArrayDeque<NewChunkHolder> pendingFullLoadUpdate = new ArrayDeque<>();
     private final MultiThreadedQueue<NewChunkHolder> offThreadPendingFullLoadUpdate = new MultiThreadedQueue<>();
     private final ObjectRBTreeSet<NewChunkHolder> autoSaveQueue = new ObjectRBTreeSet<>((final NewChunkHolder c1, final NewChunkHolder c2) -> {
@@ -910,11 +919,11 @@ public final class ChunkHolderManager {
     }
 
     public NewChunkHolder getChunkHolder(final int chunkX, final int chunkZ) {
-        return this.chunkHolders.get(CoordinateUtils.getChunkKey(chunkX, chunkZ));
+        return this.getChunkHolder(CoordinateUtils.getChunkKey(chunkX, chunkZ));
     }
 
     public NewChunkHolder getChunkHolder(final long position) {
-        return this.chunkHolders.get(position);
+        return com.latticemc.lattice.util.ChunkCache.ENABLED ? this.lattice$holderCache.get(position) : this.chunkHolders.get(position);
     }
 
     public void raisePriority(final int x, final int z, final Priority priority) {
@@ -1145,7 +1154,9 @@ public final class ChunkHolderManager {
         holder.onUnload();
         this.autoSaveQueue.remove(holder);
         PlatformHooks.get().onChunkHolderDelete(this.world, holder.vanillaChunkHolder);
-        this.chunkHolders.remove(CoordinateUtils.getChunkKey(holder.chunkX, holder.chunkZ));
+        final long key = CoordinateUtils.getChunkKey(holder.chunkX, holder.chunkZ);
+        if (com.latticemc.lattice.util.ChunkCache.ENABLED) this.lattice$holderCache.invalidate(key);
+        this.chunkHolders.remove(key);
     }
 
     // note: never call while inside the chunk system, this will absolutely break everything
diff --git a/net/minecraft/server/level/ServerChunkCache.java b/net/minecraft/server/level/ServerChunkCache.java
index af67b07722bb0125acd081dab767d7e7b360623b..704de31017280387b81d0834930e75e032428e8c 100644
--- a/net/minecraft/server/level/ServerChunkCache.java
+++ b/net/minecraft/server/level/ServerChunkCache.java
@@ -591,7 +591,18 @@ public class ServerChunkCache extends ChunkSource implements ca.spottedleaf.moon
         }
 
         profiler.popPush("tickTickingChunks");
-        this.iterateTickingChunksFaster(); // Paper - chunk tick iteration optimizations
+        final var lattice$holderManager = ((ca.spottedleaf.moonrise.patches.chunk_system.level.ChunkSystemServerLevel)this.level)
+            .moonrise$getChunkTaskScheduler().chunkHolderManager;
+        if (com.latticemc.lattice.util.ChunkCache.ENABLED) lattice$holderManager.lattice$beginTick();
+        try {
+            if (com.latticemc.lattice.world.RandomTickSystem.ENABLED) {
+                this.level.lattice$randomTickSystem.tick(this.level);
+            } else {
+                this.iterateTickingChunksFaster(); // Paper - chunk tick iteration optimizations
+            }
+        } finally {
+            if (com.latticemc.lattice.util.ChunkCache.ENABLED) lattice$holderManager.lattice$endTick();
+        }
         if (flag) {
             profiler.popPush("customSpawners");
             this.level.tickCustomSpawners(this.spawnEnemies);
diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index 48ff3c35af86a0f41e1c7ccae1ac302598243aac..83ff819f1586e50e2b5242139f1b79fbccd59249 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -979,6 +979,12 @@ public class ServerLevel extends Level implements ServerEntityGetter, WorldGenLe
     // Paper start - optimise random ticking
     private final ca.spottedleaf.moonrise.common.util.SimpleThreadUnsafeRandom simpleRandom = new ca.spottedleaf.moonrise.common.util.SimpleThreadUnsafeRandom(net.minecraft.world.level.levelgen.RandomSupport.generateUniqueSeed());
 
+    public final com.latticemc.lattice.world.RandomTickSystem lattice$randomTickSystem = com.latticemc.lattice.world.RandomTickSystem.ENABLED ? new com.latticemc.lattice.world.RandomTickSystem() : null;
+
+    public final net.minecraft.world.level.levelgen.BitRandomSource lattice$getRandomTickRandom() {
+        return this.simpleRandom;
+    }
+
     private void optimiseRandomTick(final LevelChunk chunk, final int tickSpeed) {
         final LevelChunkSection[] sections = chunk.getSections();
         final int minSection = ca.spottedleaf.moonrise.common.util.WorldUtil.getMinSection((ServerLevel)(Object)this);
