-    private final Map<MemoryModuleType<?>, Optional<? extends ExpirableValue<?>>> memories = new Reference2ReferenceOpenHashMap<>();
+    private final Reference2ReferenceOpenHashMap<MemoryModuleType<?>, Optional<? extends ExpirableValue<?>>> memories = new Reference2ReferenceOpenHashMap<>();
     // Lattice - Native brain eligibility: invalidate a snapshot after any memory write.
     private long latticeMemoryVersion;
+    private boolean latticeMemoryMapEscaped;
     private NativeEligibilityPlan latticeNativeEligibilityPlan;
     private final Map<SensorType<? extends Sensor<? super E>>, Sensor<? super E>> sensors = new Reference2ReferenceArrayMap<>();
     private final Map<Integer, Map<Activity, Set<BehaviorControl<? super E>>>> availableBehaviorsByPriority = new Object2ObjectRBTreeMap<>();
@@ -166,7 +167,7 @@ public class Brain<E extends LivingEntity> {
             memoryValue.setMemoryInternal(this);
         }
 
-        ((Reference2ReferenceOpenHashMap<MemoryModuleType<?>, Optional<? extends ExpirableValue<?>>>)this.memories).trim(); // Lattice - Leaf: optimized Brain collections
+        this.memories.trim(); // Lattice - Leaf: optimized Brain collections
     }
 
     public <T> DataResult<T> serializeStart(DynamicOps<T> ops) {
@@ -216,6 +217,16 @@ public class Brain<E extends LivingEntity> {
         }
     }
 
+    /** Lattice - version used by per-behavior memory-condition caches. */
+    public final long latticeMemoryVersion() {
+        return this.latticeMemoryVersion;
+    }
+
+    /** Lattice - live debug-map mutations cannot be observed by the version counter. */
+    public final boolean latticeMemoryConditionCacheable() {
+        return !this.latticeMemoryMapEscaped;
+    }
+
     public <U> Optional<U> getMemory(MemoryModuleType<U> type) {
         Optional<? extends ExpirableValue<?>> optional = this.memories.get(type);
         if (optional == null) {
@@ -238,6 +249,8 @@ public class Brain<E extends LivingEntity> {
     @Deprecated
     @VisibleForDebug
     public Map<MemoryModuleType<?>, Optional<? extends ExpirableValue<?>>> getMemories() {
+        this.latticeMemoryMapEscaped = true;
+        this.latticeNativeEligibilityPlan = null;
         return this.memories;
     }
 
@@ -475,11 +488,15 @@ public class Brain<E extends LivingEntity> {
         for (Entry<MemoryModuleType<?>, Optional<? extends ExpirableValue<?>>> entry : this.memories.entrySet()) {
             if (entry.getValue().isPresent()) {
                 ExpirableValue<?> expirableValue = (ExpirableValue<?>)entry.getValue().get();
-                if (expirableValue.hasExpired()) {
-                    this.eraseMemory(entry.getKey());
-                }
+                // Custom ExpirableValue subclasses may override callbacks even when they report
