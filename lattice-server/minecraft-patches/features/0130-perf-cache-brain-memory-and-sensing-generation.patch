@@ -68,6 +80,9 @@ public abstract class Behavior<E extends LivingEntity> implements BehaviorContro
      * The caller must invalidate the result when an earlier behavior changes memory.
      */
     public final boolean tryStartWithMemoryEligibility(ServerLevel level, E owner, long gameTime) {
+        if (!this.latticeUsesDefaultMemoryConditions) {
+            return this.tryStart(level, owner, gameTime);
+        }
         int tickRate = java.util.Objects.requireNonNullElse(level.paperConfig().tickRates.behavior.get(owner.getType(), this.configKey), -1);
         if (tickRate > -1 && gameTime < this.endTimestamp + tickRate) {
             return false;
@@ -86,6 +101,11 @@ public abstract class Behavior<E extends LivingEntity> implements BehaviorContro
     public final Map<MemoryModuleType<?>, MemoryStatus> latticeEntryCondition() {
         return this.entryCondition;
     }
+
+    /** Lattice - Native brain eligibility: do not bypass custom memory-condition overrides. */
+    public final boolean latticeUsesDefaultMemoryConditions() {
+        return this.latticeUsesDefaultMemoryConditions;
+    }
     protected void start(ServerLevel level, E entity, long gameTime) {
     }
 
@@ -128,14 +148,40 @@ public abstract class Behavior<E extends LivingEntity> implements BehaviorContro
     }
 
     protected boolean hasRequiredMemories(E owner) {
+        Brain<?> brain = owner.getBrain();
+        boolean cacheable = brain.latticeMemoryConditionCacheable();
+        long version = brain.latticeMemoryVersion();
+        if (this.latticeUsesDefaultMemoryConditions && cacheable && this.latticeMemoryCacheBrain == brain && this.latticeMemoryCacheVersion == version) {
+            return this.latticeMemoryCacheResult;
+        }
+
+        boolean result = true;
         for (Entry<MemoryModuleType<?>, MemoryStatus> entry : this.entryCondition.entrySet()) {
             MemoryModuleType<?> memoryModuleType = entry.getKey();
             MemoryStatus memoryStatus = entry.getValue();
-            if (!owner.getBrain().checkMemory(memoryModuleType, memoryStatus)) {
-                return false;
+            if (!brain.checkMemory(memoryModuleType, memoryStatus)) {
+                result = false;
+                break;
             }
         }
 
+        if (this.latticeUsesDefaultMemoryConditions && cacheable && brain.latticeMemoryConditionCacheable() && brain.latticeMemoryVersion() == version) {
+            this.latticeMemoryCacheBrain = brain;
+            this.latticeMemoryCacheVersion = version;
+            this.latticeMemoryCacheResult = result;
+        }
+        return result;
+    }
+
+    private static boolean usesDefaultMemoryConditions(Class<?> behaviorClass) {
+        for (Class<?> type = behaviorClass; type != null && type != Behavior.class; type = type.getSuperclass()) {
+            try {
+                type.getDeclaredMethod("hasRequiredMemories", LivingEntity.class);
+                return false;
+            } catch (NoSuchMethodException ignored) {
+                // Continue through inherited behavior classes until the base implementation.
+            }
+        }
         return true;
     }
 
