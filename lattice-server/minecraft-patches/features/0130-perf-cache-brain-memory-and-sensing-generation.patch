 public class Sensing {
     private final Mob mob;
-    private final IntSet seen = new IntOpenHashSet();
-    private final IntSet unseen = new IntOpenHashSet();
+    private final GenerationSet seen = new GenerationSet();
+    private final GenerationSet unseen = new GenerationSet();
 
     public Sensing(Mob mob) {
         this.mob = mob;
@@ -169,4 +171,68 @@ public class Sensing {
         }
         return results;
     }
+
+    /** A reusable open-addressed set whose clear operation advances a generation. */
+    private static final class GenerationSet {
+        private int[] keys = new int[32];
+        private int[] stamps = new int[32];
+        private int generation = 1;
+        private int size;
+
+        boolean contains(int key) {
+            int mask = this.keys.length - 1;
+            int slot = HashCommon.mix(key) & mask;
+            while (this.stamps[slot] == this.generation) {
+                if (this.keys[slot] == key) return true;
+                slot = (slot + 1) & mask;
+            }
+            return false;
+        }
+
+        boolean add(int key) {
+            int mask = this.keys.length - 1;
+            int slot = HashCommon.mix(key) & mask;
+            while (this.stamps[slot] == this.generation) {
+                if (this.keys[slot] == key) return false;
+                slot = (slot + 1) & mask;
+            }
+            if (this.size >= this.keys.length - (this.keys.length >>> 2)) {
+                this.grow();
+                mask = this.keys.length - 1;
+                slot = HashCommon.mix(key) & mask;
+                while (this.stamps[slot] == this.generation) slot = (slot + 1) & mask;
+            }
+            this.keys[slot] = key;
+            this.stamps[slot] = this.generation;
+            ++this.size;
+            return true;
+        }
+
+        void clear() {
+            this.size = 0;
+            if (this.generation == Integer.MAX_VALUE) {
+                Arrays.fill(this.stamps, 0);
+                this.generation = 1;
+            } else {
+                ++this.generation;
+            }
+        }
+
+        private void grow() {
+            int[] oldKeys = this.keys;
+            int[] oldStamps = this.stamps;
+            int capacity = Math.multiplyExact(oldKeys.length, 2);
+            this.keys = new int[capacity];
+            this.stamps = new int[capacity];
+            int mask = capacity - 1;
+            for (int i = 0; i < oldKeys.length; ++i) {
+                if (oldStamps[i] != this.generation) continue;
+                int key = oldKeys[i];
+                int slot = HashCommon.mix(key) & mask;
+                while (this.stamps[slot] == this.generation) slot = (slot + 1) & mask;
+                this.keys[slot] = key;
+                this.stamps[slot] = this.generation;
+            }
+        }
+    }
 }
