+                if (expirableValue.getClass() != ExpirableValue.class || expirableValue.canExpire()) {
+                    if (expirableValue.hasExpired()) {
+                        this.eraseMemory(entry.getKey());
+                    }
 
-                expirableValue.tick();
+                    expirableValue.tick();
