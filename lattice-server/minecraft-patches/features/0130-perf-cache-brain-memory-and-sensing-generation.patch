@@ -538,7 +555,9 @@ public class Brain<E extends LivingEntity> {
                     } else {
                         started = behavior.tryStart(level, entity, gameTime);
                     }
-                    snapshotValid = false;
+                    if (started || this.latticeMemoryVersion != snapshotVersion || !this.latticeMemoryConditionCacheable()) {
