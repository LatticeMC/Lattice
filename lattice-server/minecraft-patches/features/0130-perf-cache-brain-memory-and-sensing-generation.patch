                 for (int i = 0; i < group.size(); i++, flat++) {
-                    if (raw[i] instanceof Behavior<?> behavior) {
+                    if (raw[i] instanceof Behavior<?> behavior && behavior.latticeUsesDefaultMemoryConditions()) {
                         nativeIndexByFlat[flat] = nativeIndex;
                         offsets[nativeIndex] = requirement;
                         for (Entry<MemoryModuleType<?>, MemoryStatus> condition : behavior.latticeEntryCondition().entrySet()) {
diff --git a/net/minecraft/world/entity/ai/behavior/Behavior.java b/net/minecraft/world/entity/ai/behavior/Behavior.java
index 9ada478..11cd7e4 100644
--- a/net/minecraft/world/entity/ai/behavior/Behavior.java
+++ b/net/minecraft/world/entity/ai/behavior/Behavior.java
@@ -4,17 +4,28 @@ import java.util.Map;
 import java.util.Map.Entry;
 import net.minecraft.server.level.ServerLevel;
 import net.minecraft.world.entity.LivingEntity;
+import net.minecraft.world.entity.ai.Brain;
 import net.minecraft.world.entity.ai.memory.MemoryModuleType;
 import net.minecraft.world.entity.ai.memory.MemoryStatus;
 
 public abstract class Behavior<E extends LivingEntity> implements BehaviorControl<E> {
     public static final int DEFAULT_DURATION = 60;
+    private static final ClassValue<Boolean> LATTICE_DEFAULT_MEMORY_CONDITIONS = new ClassValue<>() {
+        @Override
+        protected Boolean computeValue(Class<?> behaviorClass) {
+            return usesDefaultMemoryConditions(behaviorClass);
+        }
+    };
     protected final Map<MemoryModuleType<?>, MemoryStatus> entryCondition;
     private Behavior.Status status = Behavior.Status.STOPPED;
     private long endTimestamp;
     private final int minDuration;
     private final int maxDuration;
     private final String configKey; // Paper - configurable behavior tick rate and timings
+    private final boolean latticeUsesDefaultMemoryConditions;
