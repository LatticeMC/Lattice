     public Behavior(Map<MemoryModuleType<?>, MemoryStatus> entryCondition) {
         this(entryCondition, 60);
@@ -35,6 +46,7 @@ public abstract class Behavior<E extends LivingEntity> implements BehaviorContro
             key = key.substring(lastSeparator + 1);
         }
         this.configKey = key.toLowerCase(java.util.Locale.ROOT);
+        this.latticeUsesDefaultMemoryConditions = LATTICE_DEFAULT_MEMORY_CONDITIONS.get(this.getClass());
