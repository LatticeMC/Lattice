From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sweepikun <laomgba@outlook.com>
Date: Sun, 11 Oct 2026 01:00:00 +0800
Subject: [PATCH] perf: index Brain memory and expiring slots

Keep the original map storage and iteration order. Exposed maps and
subclass callbacks retain the existing traversal.

diff --git a/net/minecraft/world/entity/ai/Brain.java b/net/minecraft/world/entity/ai/Brain.java
index 23c6c8a0272f760b142f0d1a1aa8ec9a84055128..464cf1256d325c18513016fed7427a841c8eb393 100644
--- a/net/minecraft/world/entity/ai/Brain.java
+++ b/net/minecraft/world/entity/ai/Brain.java
@@ -9,6 +9,7 @@ import com.latticemc.lattice.util.collection.ActivityArrayMap;
 import com.latticemc.lattice.util.collection.ActivityBitSet;
 import com.latticemc.lattice.util.collection.ActivityRegistryIndex;
 import com.latticemc.lattice.util.collection.BehaviorControlArraySet;
+import com.latticemc.lattice.util.collection.BrainMemoryMap;
 import com.latticemc.lattice.nativelib.NativeBrainEligibility;
 import com.mojang.datafixers.util.Pair;
 import com.mojang.logging.LogUtils;
@@ -22,7 +23,6 @@ import com.mojang.serialization.RecordBuilder;
 import it.unimi.dsi.fastutil.objects.ObjectArrayList;
 import it.unimi.dsi.fastutil.objects.Object2ObjectRBTreeMap;
 import it.unimi.dsi.fastutil.objects.Reference2ReferenceArrayMap;
-import it.unimi.dsi.fastutil.objects.Reference2ReferenceOpenHashMap;
 import java.util.Arrays;
 import java.util.Collection;
 import java.util.List;
@@ -58,7 +58,7 @@ public class Brain<E extends LivingEntity> {
     // Lattice start - Leaf: replace Brain maps with optimized collections
     private static final Map<?, ?>[] EMPTY_PRIORITY_GROUPS = new Map[0];
     private static final BehaviorControlArraySet<?>[] EMPTY_BEHAVIOR_GROUPS = new BehaviorControlArraySet[0];
-    private final Map<MemoryModuleType<?>, Optional<? extends ExpirableValue<?>>> memories = new Reference2ReferenceOpenHashMap<>();
+    private final BrainMemoryMap memories = new BrainMemoryMap();
     // Lattice - Native brain eligibility: invalidate a snapshot after any memory write.
     private long latticeMemoryVersion;
     private NativeEligibilityPlan latticeNativeEligibilityPlan;
@@ -166,7 +166,11 @@ public class Brain<E extends LivingEntity> {
             memoryValue.setMemoryInternal(this);
         }
 
-        ((Reference2ReferenceOpenHashMap<MemoryModuleType<?>, Optional<? extends ExpirableValue<?>>>)this.memories).trim(); // Lattice - Leaf: optimized Brain collections
+        this.memories.trim(); // Lattice - Leaf: optimized Brain collections
+        // Brain subclasses may override eraseMemory with reentrant callbacks.
+        if (this.getClass() == Brain.class) {
+            this.memories.initializeIndex(); // Lattice - fixed-registration memory index
+        }
     }
 
     public <T> DataResult<T> serializeStart(DynamicOps<T> ops) {
@@ -238,6 +242,7 @@ public class Brain<E extends LivingEntity> {
     @Deprecated
     @VisibleForDebug
     public Map<MemoryModuleType<?>, Optional<? extends ExpirableValue<?>>> getMemories() {
+        this.memories.disableIndex(); // Lattice - preserve externally mutable Map/view semantics
         return this.memories;
     }
 
@@ -472,6 +477,17 @@ public class Brain<E extends LivingEntity> {
     }
 
     private void forgetOutdatedMemories() {
+        // Lattice - only expiring slots, in the original hash-table iteration order.
+        if (this.memories.hasExpiryIndex()) {
+            for (int slot = this.memories.previousExpiringSlot(Integer.MAX_VALUE); slot >= 0; slot = this.memories.previousExpiringSlot(slot)) {
+                ExpirableValue<?> value = this.memories.valueAt(slot).get();
+                if (value.hasExpired()) {
+                    this.eraseMemory(this.memories.keyAt(slot));
+                }
+                value.tick();
+            }
+            return;
+        }
         for (Entry<MemoryModuleType<?>, Optional<? extends ExpirableValue<?>>> entry : this.memories.entrySet()) {
             if (entry.getValue().isPresent()) {
                 ExpirableValue<?> expirableValue = (ExpirableValue<?>)entry.getValue().get();
diff --git a/net/minecraft/world/entity/ai/memory/MemoryModuleType.java b/net/minecraft/world/entity/ai/memory/MemoryModuleType.java
index 8ffc43896e01b6709d6fdecf8a4e0d76ae3a0abe..165294b765ff1d38899406876c6925b4e4290d2c 100644
--- a/net/minecraft/world/entity/ai/memory/MemoryModuleType.java
+++ b/net/minecraft/world/entity/ai/memory/MemoryModuleType.java
@@ -30,6 +30,10 @@ import net.minecraft.world.level.pathfinder.Path;
 import net.minecraft.world.phys.Vec3;
 
 public class MemoryModuleType<U> {
+    // Lattice - 实例索引包含未注册类型，与 native eligibility 的 registry id 无关。
+    private static final java.util.concurrent.atomic.AtomicInteger LATTICE_NEXT_MEMORY_ID = new java.util.concurrent.atomic.AtomicInteger();
+    public final int latticeMemoryId = LATTICE_NEXT_MEMORY_ID.getAndIncrement();
+
     public static final MemoryModuleType<Void> DUMMY = register("dummy");
     public static final MemoryModuleType<GlobalPos> HOME = register("home", GlobalPos.CODEC);
     public static final MemoryModuleType<GlobalPos> JOB_SITE = register("job_site", GlobalPos.CODEC);
